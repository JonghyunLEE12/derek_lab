---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { siteUrl, getPosts, formatDate, tagUrl } from '../../lib/posts';
export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, category, tags } = post.data;
---
<Base title={title} description={description}>
  <article>
    <header class="page-heading"><a class="back-link" href={siteUrl('blog/')}>← 글 목록</a><p class="eyebrow">{category}</p><h1>{title}</h1><p>{description}</p>
      <div class="meta"><span>작성 <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>{updatedDate && <span>수정 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}</div>
      <ul class="tags" aria-label="글 태그">{[...new Set(tags)].map(tag => <li><a href={tagUrl(tag)}>#{tag}</a></li>)}</ul>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>
