---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { siteUrl, getAllPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getAllPosts();
  return [...new Set(posts.flatMap(post => post.data.tags))].map(tag => ({ params: { tag }, props: { tag, posts: posts.filter(post => post.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---
<Base title={`#${tag}`}><header class="page-heading"><a class="back-link" href={siteUrl('tags/')}>← 모든 태그</a><h1>#{tag}</h1><p>{posts.length}개의 기록이 있습니다.</p></header><PostList posts={posts} /></Base>
