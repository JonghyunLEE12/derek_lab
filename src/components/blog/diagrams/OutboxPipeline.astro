---
import DiagramFrame from '../../insights/diagrams/DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = '원본 변경과 outbox 적재가 한 PostgreSQL 트랜잭션에 묶이고, 워커 2개가 SKIP LOCKED로 클레임해 임베딩 해시를 비교한 뒤 전체 문서를 교체한다.' } = Astro.props;
---
<DiagramFrame caption={caption}>
  <svg class="desktop-diagram" viewBox="0 0 720 252" role="img" aria-label="어드민 저장이 원본 변경과 outbox 적재를 한 트랜잭션으로 묶고, 워커 두 개가 outbox를 클레임해 OpenSearch 문서를 전체 교체하는 흐름입니다.">
    <g>
      <rect class="accent-box" x="10" y="55" width="165" height="120" rx="9" />
      <text class="label" x="92" y="88">어드민 저장</text>
      <text class="small" x="92" y="112">원본 변경 + revision</text>
      <text class="small" x="92" y="131">outbox UPSERT</text>
      <text class="small accent-text" x="92" y="153">전부 한 트랜잭션</text>
    </g>
    <path class="flow" d="M178 115 h20" />
    <path class="arrow" d="m190 110 6 5 -6 5" />
    <g>
      <rect class="box" x="210" y="55" width="145" height="120" rx="9" />
      <text class="label" x="282" y="90">outbox</text>
      <text class="small" x="282" y="114">PENDING 행</text>
      <text class="small" x="282" y="133">pg_notify · Redis</text>
      <text class="small" x="282" y="152">1.5초 폴링 안전망</text>
    </g>
    <path class="flow" d="M357 115 C377 115 378 62 396 62" />
    <path class="arrow" d="m386 57 6 5 -6 5" />
    <path class="flow" d="M357 115 C377 115 378 188 396 188" />
    <path class="arrow" d="m386 183 6 5 -6 5" />
    <g class="pulse" style="--delay: 0s">
      <rect class="box" x="400" y="22" width="168" height="80" rx="9" />
      <text class="label" x="484" y="50">워커 1</text>
      <text class="small" x="484" y="74">SKIP LOCKED 클레임</text>
      <text class="small" x="484" y="93">lease 60초 · 15초 갱신</text>
    </g>
    <g class="pulse" style="--delay: 4s">
      <rect class="box" x="400" y="148" width="168" height="80" rx="9" />
      <text class="label" x="484" y="176">워커 2</text>
      <text class="small" x="484" y="200">임베딩 해시 비교</text>
      <text class="small" x="484" y="219">바뀐 것만 재임베딩</text>
    </g>
    <path class="flow" d="M570 62 C590 62 592 115 606 115" />
    <path class="flow" d="M570 188 C590 188 592 115 606 115" />
    <path class="arrow" d="m598 110 6 5 -6 5" />
    <g>
      <rect class="box" x="610" y="55" width="100" height="120" rx="9" />
      <text class="label" x="660" y="95">OpenSearch</text>
      <text class="small" x="660" y="119">전체 문서 교체</text>
      <text class="small" x="660" y="138">버전 가드</text>
    </g>
    <text class="small" x="360" y="244">임베딩 해시가 같으면 재임베딩 없음 · 늦게 도착한 옛 문서는 버전 가드가 거절</text>
  </svg>
  <svg class="mobile-diagram" viewBox="0 0 320 600" role="img" aria-label="어드민 저장, outbox, 색인 워커, OpenSearch로 이어지는 색인 파이프라인입니다.">
    <g>
      <rect class="accent-box" x="40" y="10" width="240" height="104" rx="9" />
      <text class="label" x="160" y="42">어드민 저장</text>
      <text class="small" x="160" y="66">원본 변경 + revision + outbox</text>
      <text class="small accent-text" x="160" y="88">전부 한 트랜잭션</text>
    </g>
    <path class="flow" d="M160 116 v24" />
    <path class="arrow" d="m155 131 5 6 5 -6" />
    <g>
      <rect class="box" x="40" y="152" width="240" height="104" rx="9" />
      <text class="label" x="160" y="184">outbox</text>
      <text class="small" x="160" y="208">pg_notify · Redis 깨우기</text>
      <text class="small" x="160" y="230">1.5초 폴링 안전망</text>
    </g>
    <path class="flow" d="M160 258 v24" />
    <path class="arrow" d="m155 273 5 6 5 -6" />
    <g class="pulse" style="--delay: 2s">
      <rect class="box" x="40" y="294" width="240" height="104" rx="9" />
      <text class="label" x="160" y="326">색인 워커 × 2</text>
      <text class="small" x="160" y="350">SKIP LOCKED · lease 60초</text>
      <text class="small" x="160" y="372">임베딩 해시 비교</text>
    </g>
    <path class="flow" d="M160 400 v24" />
    <path class="arrow" d="m155 415 5 6 5 -6" />
    <g>
      <rect class="box" x="40" y="436" width="240" height="104" rx="9" />
      <text class="label" x="160" y="468">OpenSearch</text>
      <text class="small" x="160" y="492">전체 문서 교체</text>
      <text class="small" x="160" y="514">버전 가드로 옛 쓰기 거절</text>
    </g>
    <text class="small" x="160" y="576">원본과 색인 정합성의 핵심 경로</text>
  </svg>
</DiagramFrame>
