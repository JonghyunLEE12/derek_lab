---
import DiagramFrame from '../../insights/diagrams/DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = 'vi·th는 벡터 점수 축에서 정답과 무관의 분포가 겹쳐 기준선을 어디에 놓아도 분리할 수 없지만, cross-encoder 재순위 점수 축에서는 깨끗하게 분리된다.' } = Astro.props;
---
<DiagramFrame caption={caption}>
  <svg class="desktop-diagram" viewBox="0 0 720 330" role="img" aria-label="벡터 점수 축에서는 정답 문서와 무관 질의의 점수 분포가 겹치고, 재순위 점수 축에서는 두 집합이 분리되는 모습입니다.">
    <circle class="dot-good" cx="74" cy="24" r="6" />
    <text class="small legend" x="86" y="29">정답 문서</text>
    <circle class="dot-bad" cx="180" cy="24" r="6" />
    <text class="small legend" x="192" y="29">무관 질의 최고점</text>
    <text class="small" x="480" y="29">벡터 점수 축 — vi·th 질의</text>
    <path class="route" d="M60 105 H660" />
    <text class="small" x="60" y="132">낮음</text>
    <text class="small" x="660" y="132">높음</text>
    <circle class="dot-bad" cx="230" cy="97" r="6" />
    <circle class="dot-bad" cx="272" cy="97" r="6" />
    <circle class="dot-bad" cx="318" cy="97" r="6" />
    <circle class="dot-bad" cx="362" cy="97" r="6" />
    <circle class="dot-bad" cx="402" cy="97" r="6" />
    <circle class="dot-good" cx="308" cy="113" r="6" />
    <circle class="dot-good" cx="352" cy="113" r="6" />
    <circle class="dot-good" cx="394" cy="113" r="6" />
    <circle class="dot-good" cx="448" cy="113" r="6" />
    <circle class="dot-good" cx="508" cy="113" r="6" />
    <g class="sweep">
      <line x1="0" y1="62" x2="0" y2="140" />
    </g>
    <text class="small" x="360" y="166">기준선을 어디에 놓아도 한쪽이 틀린다 (여유가 음수)</text>
    <text class="small" x="360" y="204">재순위 점수 축 — 분리 채점 후 문서별 최대</text>
    <path class="route" d="M60 268 H660" />
    <circle class="dot-bad" cx="110" cy="260" r="6" />
    <circle class="dot-bad" cx="150" cy="260" r="6" />
    <circle class="dot-bad" cx="186" cy="260" r="6" />
    <circle class="dot-bad" cx="224" cy="260" r="6" />
    <circle class="dot-bad" cx="258" cy="260" r="6" />
    <circle class="dot-good" cx="430" cy="276" r="6" />
    <circle class="dot-good" cx="474" cy="276" r="6" />
    <circle class="dot-good" cx="520" cy="276" r="6" />
    <circle class="dot-good" cx="566" cy="276" r="6" />
    <circle class="dot-good" cx="612" cy="276" r="6" />
    <line class="threshold" x1="344" y1="228" x2="344" y2="300" />
    <text class="small accent-text" x="344" y="218">locale별 기준</text>
    <text class="small" x="360" y="324">vi·th도 재순위 점수에서는 정답과 무관이 분리된다</text>
  </svg>
  <svg class="mobile-diagram" viewBox="0 0 320 390" role="img" aria-label="벡터 점수 축에서는 두 분포가 겹치고 재순위 점수 축에서는 분리됩니다.">
    <circle class="dot-good" cx="50" cy="16" r="5" />
    <text class="small legend" x="62" y="21">정답</text>
    <circle class="dot-bad" cx="120" cy="16" r="5" />
    <text class="small legend" x="132" y="21">무관</text>
    <text class="small" x="160" y="52">벡터 점수 축 (vi·th)</text>
    <path class="route" d="M30 110 H290" />
    <circle class="dot-bad" cx="95" cy="102" r="5" />
    <circle class="dot-bad" cx="120" cy="102" r="5" />
    <circle class="dot-bad" cx="146" cy="102" r="5" />
    <circle class="dot-bad" cx="170" cy="102" r="5" />
    <circle class="dot-good" cx="130" cy="118" r="5" />
    <circle class="dot-good" cx="156" cy="118" r="5" />
    <circle class="dot-good" cx="182" cy="118" r="5" />
    <circle class="dot-good" cx="214" cy="118" r="5" />
    <circle class="dot-good" cx="246" cy="118" r="5" />
    <g class="sweep sweep-m">
      <line x1="0" y1="72" x2="0" y2="146" />
    </g>
    <text class="small" x="160" y="170">어디에 놓아도 한쪽이 틀린다</text>
    <text class="small" x="160" y="240">재순위 점수 축</text>
    <path class="route" d="M30 300 H290" />
    <circle class="dot-bad" cx="55" cy="292" r="5" />
    <circle class="dot-bad" cx="75" cy="292" r="5" />
    <circle class="dot-bad" cx="95" cy="292" r="5" />
    <circle class="dot-bad" cx="115" cy="292" r="5" />
    <circle class="dot-good" cx="205" cy="308" r="5" />
    <circle class="dot-good" cx="230" cy="308" r="5" />
    <circle class="dot-good" cx="255" cy="308" r="5" />
    <circle class="dot-good" cx="280" cy="308" r="5" />
    <line class="threshold" x1="160" y1="262" x2="160" y2="330" />
    <text class="small accent-text" x="160" y="252">기준</text>
    <text class="small" x="160" y="368">분리 채점 후 문서별 최대 점수</text>
  </svg>
</DiagramFrame>
<style>
  svg text.legend { text-anchor: start; }
  .dot-good { fill: var(--accent); }
  .dot-bad { fill: var(--muted); opacity: .65; }
  .sweep line { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 5 5; }
  .sweep { animation: sweep 7s ease-in-out infinite; }
  .sweep-m { animation-name: sweep-m; }
  .threshold { stroke: var(--accent); stroke-width: 1.8; stroke-dasharray: 4 4; animation: highlight 8s ease-in-out infinite; }
  @keyframes sweep { 0%, 100% { transform: translateX(255px); } 50% { transform: translateX(475px); } }
  @keyframes sweep-m { 0%, 100% { transform: translateX(110px); } 50% { transform: translateX(220px); } }
  @keyframes highlight { 0%, 22%, 100% { opacity: .65; } 5%, 17% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .sweep, .threshold { animation: none; }
    .sweep { transform: translateX(360px); }
    .sweep-m { transform: translateX(165px); }
  }
</style>
