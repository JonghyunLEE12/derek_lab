---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "의견을 적으면 신호가 된다. 결과 평가는 끝에 점수 하나, 행동 스펙은 모든 실행의 단계별 행동이다. 포크와 시뮬레이션으로 수정안을 시험하고 시스템을 고치면 에이전트가 다시 일하고 신호가 쌓인다. 슬라이드는 이걸 한 단계 위의 보상 함수라고 부른다." } = Astro.props;
const description = "적어 둔 의견이 신호가 되고, 신호 안에서 결과 평가는 케이스 몇 개에 마지막 점수 하나를, 행동 스펙은 평가와 프로덕션의 모든 실행에서 단계별 행동을 주며, 포크와 시뮬레이션으로 수정안을 시험해 하네스나 의견을 고치고, 에이전트가 다시 일해서 신호로 돌아오는 시계 방향 루프를 보여 주는 다이어그램입니다. 슬라이드는 이것을 한 단계 위의 보상 함수라고 부릅니다.";
---
<DiagramFrame caption={caption}>
<svg class="desktop-diagram" viewBox="0 0 920 635" role="img" aria-label={description}>
<path class="route" d="M370 175 C455 20 665 20 775 175"  />
