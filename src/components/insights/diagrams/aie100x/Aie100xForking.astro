---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "저장점은 $412.06을 어떻게 할지 결정하기 직전이다. 하네스를 세 가지로 바꿔 각각 5번 포크했다. 스킬과 프롬프트를 고치면 가끔만 따르고 리뷰 도구를 고치면 항상 따른다. 고친 건 프롬프트가 아니라 도구였다." } = Astro.props;
const description = "행동 평가에 실패한 실행에서 $412.06을 어떻게 할지 결정하기 직전을 저장점으로 잡고, 월 마감 스킬 수정, 시스템 프롬프트 추가, 리뷰 도구 check_reconciliation 수정 세 가지를 각각 5번씩 포크한 결과를 보여 주는 다이어그램입니다. 스킬과 프롬프트를 고치면 가끔만 따르고 리뷰 도구를 고쳤을 때만 항상 따르며 부작용이 없습니다. 고친 건 프롬프트가 아니라 도구였습니다.";
