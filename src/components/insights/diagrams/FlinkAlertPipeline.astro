---
import DiagramFrame from './DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = '로그를 Flink에서 서비스와 path별로 집계하고, threshold를 넘으면 Kafka를 통해 알람을 보냅니다.' } = Astro.props;
const nodes = [
  { title: '애플리케이션', x: 10, width: 112 },
  { title: '로그 Kafka', x: 142, width: 108 },
  { title: 'Flink job', x: 270, width: 196 },
  { title: 'Kafka', x: 486, width: 100 },
  { title: '알람 시스템', x: 606, width: 104 },
];
---
<DiagramFrame caption={caption}>
  {[false, true].map(mobile => (
    <svg class={mobile ? 'mobile-diagram' : 'desktop-diagram'} viewBox={mobile ? '0 0 320 650' : '0 0 720 240'} role="img" aria-label="애플리케이션 로그가 Kafka를 거쳐 Flink에서 집계되고, threshold 초과 시 Kafka를 통해 알람 시스템에 전달됩니다.">
      {nodes.map((node, i) => {
        const x = mobile ? 40 : node.x;
        const y = mobile ? 16 + i * 118 : 45;
        const width = mobile ? 240 : node.width;
        return <>
          <g class={i === 4 ? 'alarm pulse' : ''} style="--delay: 4s">
            <rect class={i === 2 ? 'accent-box' : 'box'} x={x} y={y} width={width} height="92" rx="9" />
            <text class="label" x={x + width / 2} y={y + (i === 2 ? 23 : 49)}>{node.title}</text>
            {i === 2 && <>
              <text class="small" x={x + width / 2} y={y + 45}>keyBy(서비스명, path)</text>
              <text class="small" x={x + width / 2} y={y + 65}>window 집계</text>
              {[0, 1, 2, 3].map(j => <circle class="collected" cx={x + width / 2 - 21 + j * 14} cy={y + 79} r="3" style={`--delay: ${j * .8}s`} />)}
            </>}
            {i === 3 && <text class="small" x={x + width / 2} y={y + 73}>threshold 초과</text>}
          </g>
          {i < 4 && <>
            <path class="flow" d={mobile ? `M160 ${y + 94} v22` : `M${x + width + 2} 91 h16`} />
            <path class="arrow" d={mobile ? `m155 ${y + 109} 5 6 5 -6` : `m${x + width + 12} 86 6 5 -6 5`} />
          </>}
        </>;
      })}
      <text class="small" x={mobile ? 160 : 360} y={mobile ? 610 : 184}>중간 저장소 없음 · 첫 알람 수 분 → 수 초</text>
    </svg>
  ))}
</DiagramFrame>
<style>
  .collected { fill: var(--accent); animation: collect 8s ease-in-out infinite; animation-delay: var(--delay); }
  @keyframes collect { 0%, 80%, 100% { opacity: .25; } 35%, 65% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .collected { animation: none; opacity: 1; } }
</style>
