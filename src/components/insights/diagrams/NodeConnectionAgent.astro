---
import DiagramFrame from './DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = 'NAT 뒤의 파드 연결을 찾기 위해 각 노드의 에이전트가 conntrack 등의 연결 정보를 수집하고, 분석계 DB에서 조회하게 합니다.' } = Astro.props;
---
<DiagramFrame caption={caption}>
  {[false, true].map(mobile => (
    <svg class={mobile ? 'mobile-diagram' : 'desktop-diagram'} viewBox={mobile ? '0 0 320 800' : '0 0 720 500'} role="img" aria-label="파드는 노드를 거쳐 Redis 등 인프라와 통신하며 인프라에는 노드가 연결 주체로 보이고, 각 노드 에이전트는 연결 정보를 분석계 DB로 보내 누구나 쿼리할 수 있게 합니다.">
      {[0, 1].map(i => {
        const x = mobile ? 38 : 20;
        const y = 16 + i * 200;
        return <>
          <rect class="box" x={x} y={y} width="244" height="174" rx="10" />
          <text class="label" x={x + 122} y={y + 28}>쿠버네티스 노드 {i + 1}</text>
          {[0, 1].map(j => <>
            <rect class="box" x={x + 16 + j * 112} y={y + 44} width="100" height="36" rx="7" />
            <text x={x + 66 + j * 112} y={y + 68}>파드</text>
          </>)}
          <text class="small" x={x + 122} y={y + 104}>노드를 거쳐 통신 (NAT)</text>
          <g class="pulse" style={`--delay: ${i * 2}s`}>
            <rect class="accent-box" x={x + 16} y={y + 118} width="212" height="42" rx="7" />
            <text class="small" x={x + 122} y={y + 144}>에이전트 · conntrack 등</text>
          </g>
          <path class="flow" d={mobile ? `M282 ${y + 96} H304 V462 H284` : `M264 ${y + 96} H392 V148 H476`} />
          <path class="flow" d={mobile ? `M54 ${y + 139} H16 V620 H38` : `M248 ${y + 139} H350 V368 H476`} />
        </>;
      })}
      <path class="arrow" d={mobile ? 'm290 457 -6 5 6 5' : 'm470 143 6 5 -6 5'} />
      <rect class="accent-box" x={mobile ? 40 : 478} y={mobile ? 428 : 110} width={mobile ? 242 : 220} height="80" rx="9" />
      <text class="label" x={mobile ? 161 : 588} y={mobile ? 458 : 140}>인프라 (Redis 등)</text>
      <text class="small" x={mobile ? 161 : 588} y={mobile ? 486 : 168}>보이는 연결 주체: 노드</text>
      <text class="small" x={mobile ? 160 : 588} y={mobile ? 560 : 304}>각 노드의 연결 정보 수집 ↓</text>
      <path class="arrow" d={mobile ? 'm32 615 6 5 -6 5' : 'm470 363 6 5 -6 5'} />
      <rect class="accent-box" x={mobile ? 40 : 478} y={mobile ? 590 : 330} width={mobile ? 242 : 220} height="60" rx="9" />
      <text class="label" x={mobile ? 161 : 588} y={mobile ? 626 : 366}>분석계 (DB)</text>
      <path class="flow" d={mobile ? 'M160 652 V700' : 'M588 392 V436'} />
      <path class="arrow" d={mobile ? 'm155 694 5 6 5 -6' : 'm583 430 5 6 5 -6'} />
      <text class="label" x={mobile ? 160 : 588} y={mobile ? 730 : 466}>쿼리로 누구나 조회</text>
    </svg>
  ))}
</DiagramFrame>
