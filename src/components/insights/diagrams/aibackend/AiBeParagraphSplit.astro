---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "위가 V1, 아래가 V2다. V1은 문단 전체를 통째로 모델에 보내서 추론이 오래 걸린다. V2는 폴링 서버 안의 문단 나누기 컴포넌트가 스크립트를 더 짧게 자르고 순서를 보장해서 보낸다." } = Astro.props;
const description = "어닝콜 스크립트가 문단 단위로 들어올 때 스크립트 폴링 서버 V1은 문단 전체를 카프카와 요약/번역 컨슈머를 거쳐 요약/번역 모델에 통째로 보내 추론이 오래 걸리고, V2는 문단 나누기 컴포넌트로 스크립트를 더 짧게 잘라 순서를 보장해 보내서 추론 시간이 줄어드는 차이를 비교한 다이어그램입니다.";
