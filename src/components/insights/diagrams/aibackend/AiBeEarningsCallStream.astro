---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "어닝콜 하나에 추론 라인은 하나다. 폴링 서버가 스크립트를 가져오면 카프카를 거쳐 번역 모델과 요약 모델이 한 번씩 추론하고, 결과는 채널 컨슈머와 NATS와 SSE 서버를 거쳐 모든 클라이언트에 뿌려진다. 추론은 초 단위라 그 뒤 전달 구간의 지연을 줄였다." } = Astro.props;
const description = "어닝콜이 시작되면 스크립트 폴링 서버가 데이터 벤더의 S3 jsonl 스크립트를 폴링해 카프카 스크립트 토픽에 넣고, 번역 컨슈머가 번역 모델로 번역해 번역 토픽에, 요약 컨슈머가 요약 모델로 요약해 요약 토픽에 넣으면, 채널 컨슈머가 두 토픽을 받아 NATS와 SSE 서버를 거쳐 클라이언트에 브로드캐스팅하는 구조이며, 어닝콜 하나당 추론은 한 번만 하고 전달은 스트리밍으로 지연을 줄인 다이어그램입니다.";
