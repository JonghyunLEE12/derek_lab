<g class="">
<rect class="box" x="70" y="190" width="180" height="56" rx="7" />
<text class="label" x="160.0" y="223.0" style="font-size: 14px">
<tspan x="160.0" dy="0">요약/번역 컨슈머</tspan>
</text>
</g>
<g class="pulse normal">
<circle class="box" cx="160" cy="380" r="56" />
<text class="label" x="160" y="376" style="font-size: 13px">
<tspan x="160" dy="0">요약/번역</tspan>
<tspan x="160" dy="19">모델</tspan>
</text>
</g>
<text class="small timeout" x="160" y="463" style="font-size: 13px">
<tspan x="160" dy="0">타임아웃</tspan>
</text>
<g class="pulse retry">
<rect class="accent-box" x="70" y="554" width="180" height="70" rx="7" />
<text class="label" x="160.0" y="584.0" style="font-size: 14px">
<tspan x="160.0" dy="0">카프카</tspan>
</text>
<text class="small" x="160.0" y="605.0" style="font-size: 13px">
<tspan x="160.0" dy="0">(DLQ 토픽)</tspan>
</text>
</g>
<text class="small retry" x="160" y="660" style="font-size: 13px">
<tspan x="160" dy="0">요약/번역 실패 시</tspan>
<tspan x="160" dy="19">DLQ 를 활용하여 재시도</tspan>
</text>
<g class="pulse fallback">
<circle class="accent-box" cx="160" cy="784" r="58" />
<text class="label" x="160" y="780" style="font-size: 13px">
<tspan x="160" dy="0">요약/번역</tspan>
<tspan x="160" dy="19">fallback 모델</tspan>
</text>
</g>
<text class="small fallback" x="160" y="886" style="font-size: 13px">
<tspan x="160" dy="0">DLQ 과정 실패 시</tspan>
<tspan x="160" dy="19">fallback 모델에게 요청</tspan>
<tspan x="160" dy="19">(최후 안전장치로 동작)</tspan>
</text>
<g class="m-message">
<rect class="accent-box" x="148.0" y="71" width="24" height="18" rx="5" />
</g>
</svg>
</DiagramFrame>
<style>
