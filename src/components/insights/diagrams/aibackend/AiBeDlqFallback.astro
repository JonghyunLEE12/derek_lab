---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "요약과 번역 추론이 실패하면 먼저 DLQ 토픽으로 보내 재시도한다. DLQ 재시도마저 실패하면 같은 품질을 내는 fallback 모델에 요청한다. 모델을 파이프라인의 외부 노드로 보면 익숙한 전략이 그대로 쓰인다." } = Astro.props;
const description = "카프카 스크립트 토픽에서 요약/번역 컨슈머가 메시지를 받아 요약/번역 모델에 추론을 요청하고, 타임아웃 같은 실패가 나면 카프카 DLQ 토픽으로 보냈다가 다시 컨슈머로 돌려 재시도하며, DLQ 재시도마저 실패하면 최후 안전장치인 요약/번역 fallback 모델에 요청하는 복구 경로를 보여 주는 다이어그램입니다.";
---
<DiagramFrame caption={caption}>
<svg class="desktop-diagram" viewBox="0 0 920 490" role="img" aria-label={description}>
<path class="route " d="M200 110 H350" />
<path class="arrow" d="M345 106 l5 4 -5 4" />
<path class="route " d="M550 110 H708" />
<path class="arrow" d="M703 106 l5 4 -5 4" />
<path class="route accent-route" d="M450 142 V295" />
<path class="arrow" d="M446 290 l4 5 4 -5" />
<path class="route accent-route" d="M350 330 H280 V110 H350" />
<path class="arrow" d="M345 106 l5 4 -5 4" />
<path class="route accent-route" d="M550 125 H630 V330 H708" />
<path class="arrow" d="M703 326 l5 4 -5 4" />
<g class="">
<rect class="box" x="20" y="75" width="180" height="70" rx="7" />
<text class="label" x="110.0" y="105.0" style="font-size: 14px">
<tspan x="110.0" dy="0">카프카</tspan>
</text>
<text class="small" x="110.0" y="126.0" style="font-size: 13px">
<tspan x="110.0" dy="0">(스크립트 토픽)</tspan>
</text>
</g>
<g class="">
<rect class="box" x="350" y="82" width="200" height="60" rx="7" />
<text class="label" x="450.0" y="117.0" style="font-size: 14px">
<tspan x="450.0" dy="0">요약/번역 컨슈머</tspan>
</text>
</g>
<g class="pulse normal">
<circle class="box" cx="770" cy="110" r="62" />
<text class="label" x="770" y="106" style="font-size: 13px">
<tspan x="770" dy="0">요약/번역</tspan>
<tspan x="770" dy="19">모델</tspan>
</text>
</g>
<text class="small timeout" x="770" y="199" style="font-size: 13px">
<tspan x="770" dy="0">타임아웃</tspan>
</text>
<g class="pulse retry">
<rect class="accent-box" x="350" y="295" width="200" height="70" rx="7" />
<text class="label" x="450.0" y="325.0" style="font-size: 14px">
<tspan x="450.0" dy="0">카프카</tspan>
</text>
<text class="small" x="450.0" y="346.0" style="font-size: 13px">
<tspan x="450.0" dy="0">(DLQ 토픽)</tspan>
</text>
</g>
<text class="small retry" x="450" y="411" style="font-size: 12px">
<tspan x="450" dy="0">요약/번역 실패 시 DLQ 를 활용하여 재시도</tspan>
</text>
<g class="pulse fallback">
<circle class="accent-box" cx="770" cy="330" r="62" />
<text class="label" x="770" y="326" style="font-size: 13px">
<tspan x="770" dy="0">요약/번역</tspan>
<tspan x="770" dy="19">fallback 모델</tspan>
</text>
</g>
<text class="small fallback" x="770" y="435" style="font-size: 12px">
<tspan x="770" dy="0">DLQ 과정 실패 시 fallback 모델에게 요청</tspan>
<tspan x="770" dy="19">(최후 안전장치로 동작)</tspan>
</text>
<g class="d-message">
<rect class="accent-box" x="98.0" y="122" width="24" height="18" rx="5" />
</g>
</svg>
<svg class="mobile-diagram" viewBox="0 0 320 970" role="img" aria-label={description}>
<path class="route " d="M160 94 V190" />
<path class="arrow" d="M156 185 l4 5 4 -5" />
