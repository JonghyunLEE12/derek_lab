svg .pulse .box { stroke: var(--line); }
svg .accent-route { stroke: var(--accent); }
svg .flow { animation-duration: 16s; }
svg .normal { animation: normal 16s ease-in-out infinite; }
@keyframes normal {0%, 100% { opacity: .65; }12.5%, 18.75% { opacity: .65; }14.0625%, 17.1875% { opacity: 1; }43.75%, 50.0% { opacity: .65; }45.3125%, 48.4375% { opacity: 1; }}
