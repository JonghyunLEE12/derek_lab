---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "다섯 가지 성질을 ISO 25010 품질 특성 셋에 연결한 그림. 비결정성과 부분 실패는 신뢰성, 레이턴시 분포와 비용은 효율성이다. 정답이 없는 SLO만 점선인데 지금은 유지보수성 쪽에서 접근하고 있다." } = Astro.props;
const description = "AI 컴포넌트의 다섯 가지 성질 중 비결정성과 부분 실패는 신뢰성으로, 레이턴시 분포와 비용의 선형 증가는 효율성으로 연결되고, 정답이 없는 SLO는 100% 해결이 어렵다고 보고 지금은 유지보수성 쪽에서 접근한다는 ISO 25010 품질 특성 대응을 보여 주는 다이어그램입니다.";
---
<DiagramFrame caption={caption}>
<svg class="desktop-diagram" viewBox="0 0 900 690" role="img" aria-label={description}>
<text class="small" x="230" y="22" style="font-size: 13px">
<tspan x="230" dy="0">AI 컴포넌트가 깨뜨리는 백엔드의 기본 가정</tspan>
</text>
<path class="route  " d="M133 100 H460 V180 H660" />
<g class="path0">
<path class="flow " d="M133 100 H460 V180 H660" />
</g>
<path class="arrow" d="M655 176 l5 4 -5 4" />
<path class="route  " d="M133 215 H485 V350 H660" />
<g class="path1">
<path class="flow " d="M133 215 H485 V350 H660" />
</g>
<path class="arrow" d="M655 346 l5 4 -5 4" />
<path class="route  " d="M133 330 H510 V180 H660" />
