---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = 'Speech Tokenizer가 LLM의 정답 역할을 하기 때문에 토크나이저의 한계가 그대로 TTS의 한계가 된다. 학습 데이터셋의 분포, 이산화, Semantic distillation 세 지점이 병목이다. 마지막은 영어로 학습된 Semantic teacher에서 온다.' } = Astro.props;
const description = '학습 음성이 인코더와 VQ layer, 즉 Speech Tokenizer를 거쳐 이산 토큰이 되고 LLM이 그 토큰을 정답으로 학습하는 흐름 위에, 세 병목을 표시했습니다. 첫째는 토크나이저 학습 데이터셋의 분포, 둘째는 연속 표현을 이산으로 바꾸는 이산화, 셋째는 wav2vec 2.0, WavLM, Wav2Vec2-BERT처럼 거의 영어로 학습된 Semantic teacher에서 오는 Semantic distillation입니다.';
---
<DiagramFrame caption={caption}>
  <svg class="desktop-diagram" viewBox="0 0 720 360" role="img" aria-label={description}>
    <rect class="box" x="204" y="16" width="224" height="94" rx="7" />
    <text class="small" x="316.0" y="38" style="font-size: 14px">Semantic teacher</text>
    <text class="small" x="316.0" y="58" style="font-size: 12px">wav2vec 2.0 · WavLM</text>
    <text class="small" x="316.0" y="76" style="font-size: 12px">Wav2Vec2-BERT</text>
    <g class="teacher-language">
    <text class="small" x="316" y="97" style="font-size: 11px">거의 영어로 학습</text>
    </g>
    <path class="route" d="M316 110 V168" />
    <path class="flow stream-6-5-3" d="M316 110 V168" />
    <path class="arrow" d="M312 163 l4 5 4 -5" />
    <text class="small" x="399" y="142" style="font-size: 12px">Semantic distillation</text>
    <rect class="box" x="8" y="170" width="94" height="64" rx="7" />
    <text class="label" x="55.0" y="192" style="font-size: 14px">학습 음성</text>
    <g class="wave-fade">
    <line class="wave-bar" x1="35" x2="35" y1="213.0" y2="219.0" />
    <line class="wave-bar" x1="40" x2="40" y1="210.0" y2="222.0" />
    <line class="wave-bar" x1="45" x2="45" y1="206.0" y2="226.0" />
    <line class="wave-bar" x1="50" x2="50" y1="209.0" y2="223.0" />
    <line class="wave-bar" x1="55" x2="55" y1="204.0" y2="228.0" />
    <line class="wave-bar" x1="60" x2="60" y1="208.0" y2="224.0" />
    <line class="wave-bar" x1="65" x2="65" y1="211.0" y2="221.0" />
    <line class="wave-bar" x1="70" x2="70" y1="207.0" y2="225.0" />
    <line class="wave-bar" x1="75" x2="75" y1="212.0" y2="220.0" />
    </g>
    <polygon class="box" points="136,170 228,180 228,224 136,234" />
    <text class="label" x="182.0" y="207.0" style="font-size: 14px">인코더</text>
    <rect class="accent-box" x="262" y="170" width="108" height="64" rx="7" />
    <text class="label" x="316.0" y="192" style="font-size: 14px">VQ layer</text>
    <text class="small" x="316.0" y="212" style="font-size: 12px">Speech Tokenizer</text>
    <rect class="box" x="544" y="170" width="90" height="64" rx="7" />
    <text class="label" x="589.0" y="207.0" style="font-size: 14px">LLM</text>
    <path class="route" d="M102 202 H134" />
    <path class="flow stream-0-0-5" d="M102 202 H134" />
    <path class="arrow" d="M129 198 l5 4 -5 4" />
    <path class="route" d="M228 202 H260" />
    <path class="flow stream-0-5-0-5" d="M228 202 H260" />
    <path class="arrow" d="M255 198 l5 4 -5 4" />
    <path class="route" d="M370 202 H398" />
    <path class="flow stream-4-2-5" d="M370 202 H398" />
    <path class="arrow" d="M393 198 l5 4 -5 4" />
    <path class="route" d="M494 202 H542" />
    <path class="flow stream-1-5-0-5" d="M494 202 H542" />
    <path class="arrow" d="M537 198 l5 4 -5 4" />
    <g class="bottleneck-token-0">
    <rect class="box" x="402" y="193" width="18" height="18" rx="4" />
    <text class="small" x="411" y="206" style="font-size: 12px">3</text>
    </g>
    <g class="information-loss">
    <g class="bottleneck-token-1">
    <rect class="box" x="426" y="193" width="18" height="18" rx="4" />
    <text class="small" x="435" y="206" style="font-size: 12px">1</text>
    </g>
    </g>
    <g class="bottleneck-token-2">
    <rect class="box" x="450" y="193" width="18" height="18" rx="4" />
    <text class="small" x="459" y="206" style="font-size: 12px">2</text>
    </g>
    <g class="information-loss">
    <g class="bottleneck-token-3">
    <rect class="box" x="474" y="193" width="18" height="18" rx="4" />
    <text class="small" x="483" y="206" style="font-size: 12px">3</text>
    </g>
    </g>
    <text class="small" x="447" y="240">discrete</text>
    <text class="small" x="598" y="259" style="font-size: 12px">VQ 결과가 LLM의 정답 역할</text>
    <path class="route" d="M55 234 V270" />
    <path class="route" d="M384 202 V270" />
    <path class="route" d="M478 62 H428" />
    <rect class="box bottleneck-①" x="8" y="272" width="278" height="80" rx="7" stroke-dasharray="4 3"/>
    <text class="small" x="147.0" y="294" style="font-size: 12px"><tspan class="accent-text">①</tspan> 학습 데이터셋의 분포</text>
    <text class="small" x="147.0" y="313" style="font-size: 12px">(of Speech Tokenizer)</text>
    <text class="small" x="147.0" y="332" style="font-size: 12px">한국어가 적으면 한국어 성능도 떨어진다</text>
    <rect class="box bottleneck-②" x="310" y="272" width="280" height="80" rx="7" stroke-dasharray="4 3"/>
    <text class="small" x="450.0" y="294" style="font-size: 12px"><tspan class="accent-text">②</tspan> 이산화</text>
    <text class="small" x="450.0" y="313" style="font-size: 12px">(Discretization)</text>
    <text class="small" x="450.0" y="332" style="font-size: 12px">연속 → 이산, 정보가 사라질 수 있다</text>
    <rect class="box bottleneck-③" x="478" y="26" width="234" height="70" rx="7" stroke-dasharray="4 3"/>
    <text class="small" x="595.0" y="48" style="font-size: 12px"><tspan class="accent-text">③</tspan> Semantic distillation</text>
    <text class="small" x="595.0" y="67" style="font-size: 12px">영어 원어민한테</text>
    <text class="small" x="595.0" y="86" style="font-size: 12px">한국어를 배우는 셈</text>
  </svg>
  <svg class="mobile-diagram" viewBox="0 0 320 820" role="img" aria-label={description}>
    <rect class="box" x="14" y="28" width="136" height="64" rx="7" />
    <text class="label" x="82.0" y="50" style="font-size: 14px">학습 음성</text>
    <g class="wave-fade">
    <line class="wave-bar" x1="62" x2="62" y1="71.0" y2="77.0" />
    <line class="wave-bar" x1="67" x2="67" y1="68.0" y2="80.0" />
    <line class="wave-bar" x1="72" x2="72" y1="64.0" y2="84.0" />
    <line class="wave-bar" x1="77" x2="77" y1="67.0" y2="81.0" />
    <line class="wave-bar" x1="82" x2="82" y1="62.0" y2="86.0" />
    <line class="wave-bar" x1="87" x2="87" y1="66.0" y2="82.0" />
    <line class="wave-bar" x1="92" x2="92" y1="69.0" y2="79.0" />
    <line class="wave-bar" x1="97" x2="97" y1="65.0" y2="83.0" />
    <line class="wave-bar" x1="102" x2="102" y1="70.0" y2="78.0" />
    </g>
    <polygon class="box" points="14,137 150,147 150,181 14,191" />
    <text class="label" x="82.0" y="169.0" style="font-size: 14px">인코더</text>
    <path class="route" d="M82 92 V135" />
    <path class="flow stream-0-0-5" d="M82 92 V135" />
    <path class="arrow" d="M78 130 l4 5 4 -5" />
    <path class="route" d="M82 191 V214 H8 V425 H82 V438" />
    <path class="flow stream-0-5-0-5" d="M82 191 V214 H8 V425 H82 V438" />
    <path class="arrow" d="M78 433 l4 5 4 -5" />
    <rect class="box" x="14" y="254" width="136" height="118" rx="7" />
    <text class="small" x="82.0" y="276" style="font-size: 14px">Semantic teacher</text>
    <text class="small" x="82.0" y="299" style="font-size: 11px">wav2vec 2.0 · WavLM</text>
    <text class="small" x="82.0" y="320" style="font-size: 12px">Wav2Vec2-BERT</text>
    <g class="teacher-language">
    <text class="small" x="82" y="351" style="font-size: 11px">거의 영어로 학습</text>
    </g>
    <path class="route" d="M115 372 V438" />
    <path class="flow stream-6-5-3" d="M115 372 V438" />
    <path class="arrow" d="M111 433 l4 5 4 -5" />
    <text class="small" x="206" y="401" style="font-size: 12px">Semantic distillation</text>
    <rect class="accent-box" x="14" y="440" width="136" height="64" rx="7" />
    <text class="label" x="82.0" y="462" style="font-size: 14px">VQ layer</text>
    <text class="small" x="82.0" y="482" style="font-size: 12px">Speech Tokenizer</text>
    <path class="route" d="M82 504 V550" />
    <path class="flow stream-4-2-5" d="M82 504 V550" />
    <path class="arrow" d="M78 545 l4 5 4 -5" />
    <g class="bottleneck-token-0">
    <rect class="box" x="61" y="558" width="18" height="18" rx="4" />
    <text class="small" x="70" y="571" style="font-size: 12px">3</text>
    </g>
    <g class="information-loss">
    <g class="bottleneck-token-1">
    <rect class="box" x="85" y="558" width="18" height="18" rx="4" />
    <text class="small" x="94" y="571" style="font-size: 12px">1</text>
    </g>
    </g>
    <g class="bottleneck-token-2">
    <rect class="box" x="61" y="582" width="18" height="18" rx="4" />
    <text class="small" x="70" y="595" style="font-size: 12px">2</text>
    </g>
    <g class="information-loss">
    <g class="bottleneck-token-3">
    <rect class="box" x="85" y="582" width="18" height="18" rx="4" />
    <text class="small" x="94" y="595" style="font-size: 12px">3</text>
    </g>
    </g>
    <text class="small" x="82" y="626">discrete</text>
    <path class="route" d="M82 639 V701" />
    <path class="flow stream-1-5-0-5" d="M82 639 V701" />
    <path class="arrow" d="M78 696 l4 5 4 -5" />
    <rect class="box" x="14" y="703" width="136" height="54" rx="7" />
    <text class="label" x="82.0" y="735.0" style="font-size: 14px">LLM</text>
    <text class="small" x="160" y="795" style="font-size: 13px">VQ 결과가 LLM의 정답 역할</text>
    <path class="route" d="M170 60 H150" />
    <path class="route" d="M170 530 H82" />
    <path class="route" d="M170 306 H150" />
    <rect class="box bottleneck-①" x="170" y="16" width="140" height="132" rx="7" stroke-dasharray="4 3"/>
    <text class="small" x="240.0" y="38" style="font-size: 12px"><tspan class="accent-text">①</tspan> 학습 데이터셋의</text>
    <text class="small" x="240.0" y="57" style="font-size: 12px">분포</text>
    <text class="small" x="240.0" y="76" style="font-size: 12px">(of Speech Tokenizer)</text>
    <text class="small" x="240.0" y="95" style="font-size: 12px">한국어가 적으면</text>
    <text class="small" x="240.0" y="114" style="font-size: 12px">한국어 성능도 떨어진다</text>
    <rect class="box bottleneck-②" x="170" y="494" width="140" height="132" rx="7" stroke-dasharray="4 3"/>
    <text class="small" x="240.0" y="516" style="font-size: 12px"><tspan class="accent-text">②</tspan> 이산화</text>
    <text class="small" x="240.0" y="535" style="font-size: 12px">(Discretization)</text>
    <text class="small" x="240.0" y="554" style="font-size: 12px">연속 → 이산,</text>
    <text class="small" x="240.0" y="573" style="font-size: 12px">정보가 사라질 수 있다</text>
    <rect class="box bottleneck-③" x="170" y="254" width="140" height="118" rx="7" stroke-dasharray="4 3"/>
    <text class="small" x="240.0" y="276" style="font-size: 12px"><tspan class="accent-text">③</tspan> Semantic</text>
    <text class="small" x="240.0" y="295" style="font-size: 12px">distillation</text>
    <text class="small" x="240.0" y="314" style="font-size: 12px">영어 원어민한테</text>
    <text class="small" x="240.0" y="333" style="font-size: 12px">한국어를 배우는 셈</text>
  </svg>
</DiagramFrame>
<style>
  /* Static routes remain readable throughout the timed accent sequence. */
  svg .flow { opacity: 0; }
  svg .pulse .box { stroke: var(--line); }
  .wave-bar { stroke: var(--muted); stroke-width: 2; stroke-linecap: round; transform-box: fill-box; transform-origin: center; }
  svg .teacher-language { animation: teacher-language 12s ease-in-out infinite; }
  @keyframes teacher-language { 0%, 54.1667%, 79.1667%, 100% { opacity: .6; } 66.6667% { opacity: 1; } }
  svg .stream-6-5-3 { animation: stream-6-5-3 12s linear infinite; }
  @keyframes stream-6-5-3 { 0%, 54.1667%, 79.1667%, 100% { opacity: 0; stroke-dashoffset: 0; } 54.2667% { opacity: 1; } 79.0667% { opacity: 1; stroke-dashoffset: -42; } }
  svg .wave-fade { animation: wave-fade 12s ease-in-out infinite; }
  @keyframes wave-fade { 0%, 16.6667%, 33.3333%, 100% { opacity: 1; } 25.0000% { opacity: .5; } }
  svg .stream-0-0-5 { animation: stream-0-0-5 12s linear infinite; }
  @keyframes stream-0-0-5 { 0%, 0.0000%, 4.1667%, 100% { opacity: 0; stroke-dashoffset: 0; } 0.1000% { opacity: 1; } 4.0667% { opacity: 1; stroke-dashoffset: -42; } }
  svg .stream-0-5-0-5 { animation: stream-0-5-0-5 12s linear infinite; }
  @keyframes stream-0-5-0-5 { 0%, 4.1667%, 8.3333%, 100% { opacity: 0; stroke-dashoffset: 0; } 4.2667% { opacity: 1; } 8.2333% { opacity: 1; stroke-dashoffset: -42; } }
  svg .stream-4-2-5 { animation: stream-4-2-5 12s linear infinite; }
  @keyframes stream-4-2-5 { 0%, 33.3333%, 54.1667%, 100% { opacity: 0; stroke-dashoffset: 0; } 33.4333% { opacity: 1; } 54.0667% { opacity: 1; stroke-dashoffset: -42; } }
  svg .stream-1-5-0-5 { animation: stream-1-5-0-5 12s linear infinite; }
  @keyframes stream-1-5-0-5 { 0%, 12.5000%, 16.6667%, 100% { opacity: 0; stroke-dashoffset: 0; } 12.6000% { opacity: 1; } 16.5667% { opacity: 1; stroke-dashoffset: -42; } }
  svg .bottleneck-token-0 { animation: bottleneck-token-0 12s ease-in-out infinite; }
  @keyframes bottleneck-token-0 { 0%, 8.3333% { opacity: .35; } 10.8333%, 99% { opacity: 1; } 100% { opacity: .35; } }
  svg .bottleneck-token-1 { animation: bottleneck-token-1 12s ease-in-out infinite; }
  @keyframes bottleneck-token-1 { 0%, 9.3333% { opacity: .35; } 11.8333%, 99% { opacity: 1; } 100% { opacity: .35; } }
  svg .information-loss { animation: information-loss 12s ease-in-out infinite; }
  @keyframes information-loss { 0%, 33.3333%, 54.1667%, 100% { opacity: 1; } 43.7500% { opacity: .4; } }
  svg .bottleneck-token-2 { animation: bottleneck-token-2 12s ease-in-out infinite; }
  @keyframes bottleneck-token-2 { 0%, 10.3333% { opacity: .35; } 12.8333%, 99% { opacity: 1; } 100% { opacity: .35; } }
  svg .bottleneck-token-3 { animation: bottleneck-token-3 12s ease-in-out infinite; }
  @keyframes bottleneck-token-3 { 0%, 11.3333% { opacity: .35; } 13.8333%, 99% { opacity: 1; } 100% { opacity: .35; } }
  svg .bottleneck-① { animation: bottleneck-① 12s ease-in-out infinite; }
  @keyframes bottleneck-① { 0%, 16.6667%, 33.3333%, 100% { stroke: var(--line); } 25.0000% { stroke: var(--accent); } }
  svg .bottleneck-② { animation: bottleneck-② 12s ease-in-out infinite; }
  @keyframes bottleneck-② { 0%, 33.3333%, 54.1667%, 100% { stroke: var(--line); } 43.7500% { stroke: var(--accent); } }
  svg .bottleneck-③ { animation: bottleneck-③ 12s ease-in-out infinite; }
  @keyframes bottleneck-③ { 0%, 54.1667%, 79.1667%, 100% { stroke: var(--line); } 66.6667% { stroke: var(--accent); } }

  @media (prefers-reduced-motion: reduce) {
    svg * { animation: none !important; transform: none !important; opacity: 1; }
    svg .mel-cell { opacity: .9 !important; }
  }
</style>
