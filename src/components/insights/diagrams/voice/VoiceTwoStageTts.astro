const { caption = '텍스트가 Acoustic Model을 거쳐 Mel-spectrogram이 되고 Vocoder가 그걸 Waveform으로 바꾼다. 가운데 Mel-spectrogram을 중간 표현으로 쓰는 2단계 구조다.' } = Astro.props;
const description = '텍스트 안녕하세요가 Tacotron2나 FastSpeech2 같은 Acoustic Model을 거쳐 Mel-spectrogram이 되고, HiFi-GAN 같은 Vocoder가 그 Mel-spectrogram을 Waveform 음성으로 바꾸는 2단계 TTS 구조입니다.';
