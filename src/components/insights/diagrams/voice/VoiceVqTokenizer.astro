---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = '음성이 인코더를 지나 연속 벡터가 되고 VQ layer가 코드북에서 가장 가까운 코드로 바꾼다. 디코더가 복원한 음성과 원본의 복원 오차로 학습한다. 학습이 끝나면 음성은 코드 번호의 시퀀스가 되고 LLM이 텍스트 토큰처럼 학습한다.' } = Astro.props;
const description = '음성이 인코더를 지나 연속 벡터가 되고 VQ layer가 코드북에서 가장 가까운 코드로 양자화한 뒤 디코더가 복원 음성을 만들며, 원본과의 복원 오차로 학습합니다. 학습이 끝나면 같은 VQ layer가 음성을 1, 2, 3 같은 코드 번호의 토큰 시퀀스로 바꾸고 LLM이 그 시퀀스를 텍스트 토큰처럼 학습합니다.';
