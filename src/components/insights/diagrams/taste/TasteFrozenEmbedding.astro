    <path class="route" d="M589 234 L589 254" />
    <path class="flow" style="--delay: 5.5s" d="M589 234 L589 254" />
    <path class="arrow" d="M585 249 l4 5 4 -5" />
    <g class="pulse" style="--delay: 5.5s">
    <rect class="accent-box" x="474" y="256" width="230" height="42" rx="7" />
    <text class="label" x="589" y="283">미니앱 추천 모델</text>
    </g>
    <text class="small" x="589" y="321">어떤 미니앱을 추천할까?</text>
  </svg>
  <svg class="mobile-diagram" viewBox="0 0 320 738" role="img" aria-label="가중치를 고정한 TASTE의 Shared Encoder가 유저 정보에서 유저 임베딩을 추출하고, 그 임베딩이 입력 피처로 푸시 모델과 미니앱 추천 모델에 들어갑니다. 다운스트림 모델만 따로 학습하며 기존 대출, 보험, 결제 Head는 그대로입니다.">
    <text class="small" x="160" y="20">TASTE · Frozen</text>
    <rect class="box" x="28" y="36" width="264" height="30" rx="7" />
