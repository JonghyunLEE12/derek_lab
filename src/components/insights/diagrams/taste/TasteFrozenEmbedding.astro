---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = '왼쪽 TASTE는 가중치를 고정하고 유저 임베딩만 추출한다. 오른쪽 푸시 모델과 미니앱 추천 모델은 자기 피처에 이 임베딩을 더해 따로 학습한다. 새 목적의 gradient는 Shared Encoder로 돌아가지 않는다.' } = Astro.props;
---
<DiagramFrame caption={caption}>
  <svg class="desktop-diagram" viewBox="0 0 720 344" role="img" aria-label="가중치를 고정한 TASTE의 Shared Encoder가 유저 정보에서 유저 임베딩을 추출하고, 그 임베딩이 입력 피처로 푸시 모델과 미니앱 추천 모델에 들어갑니다. 다운스트림 모델만 따로 학습하며 기존 대출, 보험, 결제 Head는 그대로입니다.">
    <text class="small" x="160" y="20">TASTE · Frozen</text>
    <rect class="box" x="28" y="36" width="264" height="30" rx="7" />
    <text class="small" x="160" y="57">유저 정보</text>
    <path class="route" d="M160 66 L160 86" />
    <path class="flow" style="--delay: 0s" d="M160 66 L160 86" />
    <path class="arrow" d="M156 81 l4 5 4 -5" />
    <g class="pulse" style="--delay: 0.8s">
    <rect class="accent-box" x="28" y="88" width="264" height="60" rx="7" />
    <text class="label" x="160" y="113">Shared Encoder</text>
    <text class="small" x="160" y="136" style="font-size: 14px">가중치 고정 · 학습된 표현 추출</text>
    </g>
    <path class="route" d="M160 148 L160 168" />
    <path class="flow" style="--delay: 2s" d="M160 148 L160 168" />
    <path class="arrow" d="M156 163 l4 5 4 -5" />
    <g class="pulse" style="--delay: 2.4s">
    <rect class="box" x="70" y="170" width="180" height="76" rx="7" />
    <text class="label" x="160" y="194">유저 임베딩</text>
    <rect class="vector-bar" x="134" y="223" width="5" height="12" rx="2" />
    <rect class="vector-bar" x="142" y="213" width="5" height="22" rx="2" />
    <rect class="vector-bar" x="150" y="203" width="5" height="32" rx="2" />
    <rect class="vector-bar" x="158" y="195" width="5" height="40" rx="2" />
    <rect class="vector-bar" x="166" y="203" width="5" height="32" rx="2" />
    <rect class="vector-bar" x="174" y="213" width="5" height="22" rx="2" />
    <rect class="vector-bar" x="182" y="223" width="5" height="12" rx="2" />
    </g>
    <g class="inactive">
    <path class="route" d="M160 246 V257 H56 V271" />
    <path class="arrow" d="M52 266 l4 5 4 -5" />
    <rect class="box" x="8" y="273" width="96" height="32" rx="7" />
    <text class="small" x="56" y="295">대출 Head</text>
    <text class="small" x="56" y="326">대출 예측</text>
    <path class="route" d="M160 246 V257 H160 V271" />
    <path class="arrow" d="M156 266 l4 5 4 -5" />
    <rect class="box" x="112" y="273" width="96" height="32" rx="7" />
    <text class="small" x="160" y="295">보험 Head</text>
    <text class="small" x="160" y="326">보험 예측</text>
    <path class="route" d="M160 246 V257 H264 V271" />
    <path class="arrow" d="M260 266 l4 5 4 -5" />
    <rect class="box" x="216" y="273" width="96" height="32" rx="7" />
    <text class="small" x="264" y="295">결제 Head</text>
    <text class="small" x="264" y="326">결제 예측</text>
    </g>
    <path class="divider" d="M374 16 V336" />
    <text class="small" x="554" y="20">Downstream · Trainable</text>
    <path class="route" d="M250 208 H404 V111 H470" />
    <path class="flow" style="--delay: 3s" d="M250 208 H404 V111 H470" />
    <path class="arrow" d="M465 107 l5 4 -5 4" />
    <path class="route" d="M250 208 H404 V277 H470" />
    <path class="flow" style="--delay: 4s" d="M250 208 H404 V277 H470" />
    <path class="arrow" d="M465 273 l5 4 -5 4" />
