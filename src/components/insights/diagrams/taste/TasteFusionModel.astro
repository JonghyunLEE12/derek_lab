---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = '유저 요약 정보는 DCN-V2로, 시간순 앱이벤트는 6층 Causal Transformer로 각각 192차원 벡터가 된다. Gated Fusion이 둘을 묶어 192차원 유저 표현을 만들고 PLE가 189개 앱이벤트 확률을 낸다.' } = Astro.props;
