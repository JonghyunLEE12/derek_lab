<text class="small" x="175.0" y="331" style="font-size: 11px"><tspan x="175.0" dy="0">출시 후 운영</tspan></text>
</g>
<path class="route" d="M20 454.0 H8"  />
<path class="route" d="M20 361 H310"  />
<text class="small" x="106" y="385" style="font-size: 11px"><tspan x="106" dy="0">가장 걱정한 일</tspan></text>
<g class="" data-stage="row4"><rect class="box" x="20" y="400" width="290" height="108" rx="7"  />
<rect class="box" x="32" y="418" width="16" height="16" rx="2"  />
<path class="arrow" d="M35 426 l4 4 7 -9" data-stage="check4"  />
<text class="label" x="175.0" y="423" style="font-size: 13px"><tspan x="175.0" dy="0">인증</tspan></text>
