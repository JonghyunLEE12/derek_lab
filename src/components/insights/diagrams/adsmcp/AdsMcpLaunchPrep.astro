---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "출시 전에 챙긴 일들이다. 위 네 줄은 원문이 나열한 순서이고 시간 순서는 아니다. 인증은 OAuth 2.1 표준을 따랐고 Codex는 출시 전에 정식 버전이 이 인증 방식을 지원했다. 광고 MCP는 9월 16일에 공개 베타로 나왔다." } = Astro.props;
const description = "출시 전에 챙긴 일인 약관 검토와 법무팀 확인, 호출 한도, 연결 가이드와 서비스 내 안내 화면, 운영 대시보드, OAuth 2.1과 광고주 본인 동의를 따르는 인증이 차례로 채워지고, 알파 버전에만 있던 Codex의 인증 방식 지원이 출시 전에 정식 버전에도 들어온 뒤, 광고 MCP가 9월 16일 공개 베타 출시로 이어지는 과정을 그린 다이어그램입니다.";
---
<DiagramFrame caption={caption}>
<svg class="desktop-diagram" viewBox="0 0 920 638" role="img" aria-label={description}>
<text class="label" x="305" y="25" style="font-size: 15px"><tspan x="305" dy="0">출시 전에 챙긴 일</tspan></text>
<path class="route" d="M580 80.0 H640"  />
<g class="" data-stage="row0"><rect class="box" x="25" y="48" width="555" height="64" rx="7"  />
<rect class="box" x="37" y="66" width="16" height="16" rx="2"  />
<path class="arrow" d="M40 74 l4 4 7 -9" data-stage="check0"  />
<text class="label" x="312.5" y="71" style="font-size: 14px"><tspan x="312.5" dy="0">약관 검토 · 법무팀 확인</tspan></text>
<text class="small" x="312.5" y="94" style="font-size: 13px"><tspan x="312.5" dy="0">AI가 광고주의 계정을 대신 다룬다</tspan></text>
</g>
<path class="route" d="M580 158.0 H640"  />
<g class="" data-stage="row1"><rect class="box" x="25" y="126" width="555" height="64" rx="7"  />
<rect class="box" x="37" y="144" width="16" height="16" rx="2"  />
<path class="arrow" d="M40 152 l4 4 7 -9" data-stage="check1"  />
<text class="label" x="312.5" y="149" style="font-size: 14px"><tspan x="312.5" dy="0">호출 한도</tspan></text>
<text class="small" x="312.5" y="172" style="font-size: 13px"><tspan x="312.5" dy="0">기존 서버에 부하가 가지 않게</tspan></text>
</g>
<path class="route" d="M580 236.0 H640"  />
<g class="" data-stage="row2"><rect class="box" x="25" y="204" width="555" height="64" rx="7"  />
<rect class="box" x="37" y="222" width="16" height="16" rx="2"  />
<path class="arrow" d="M40 230 l4 4 7 -9" data-stage="check2"  />
<text class="label" x="312.5" y="227" style="font-size: 14px"><tspan x="312.5" dy="0">연결 가이드 · 서비스 내 안내 화면</tspan></text>
<text class="small" x="312.5" y="250" style="font-size: 13px"><tspan x="312.5" dy="0">광고주용</tspan></text>
</g>
<path class="route" d="M580 314.0 H640"  />
<g class="" data-stage="row3"><rect class="box" x="25" y="282" width="555" height="64" rx="7"  />
<rect class="box" x="37" y="300" width="16" height="16" rx="2"  />
<path class="arrow" d="M40 308 l4 4 7 -9" data-stage="check3"  />
<text class="label" x="312.5" y="305" style="font-size: 14px"><tspan x="312.5" dy="0">운영 대시보드</tspan></text>
<text class="small" x="312.5" y="328" style="font-size: 13px"><tspan x="312.5" dy="0">출시 후 운영</tspan></text>
</g>
<path class="route" d="M580 450.0 H640"  />
<path class="route" d="M25 361 H580"  />
<text class="small" x="111" y="385" style="font-size: 11px"><tspan x="111" dy="0">가장 걱정한 일</tspan></text>
