<g class="" data-stage="codex"><rect class="box pending-layer waiting" x="25" y="520" width="555" height="100" rx="7" data-stage="pending" />
<rect class="box" x="25" y="520" width="555" height="100" rx="7" data-stage="ready" />
<rect class="box pending-layer waiting" x="37" y="538" width="16" height="16" rx="2" data-stage="pending" />
<rect class="box" x="37" y="538" width="16" height="16" rx="2" data-stage="ready" />
<path class="arrow" d="M40 546 l4 4 7 -9" data-stage="check5"  />
<text class="label" x="312.5" y="543" style="font-size: 14px"><tspan x="312.5" dy="0">Codex 연결</tspan></text>
<text class="small" x="312.5" y="566" style="font-size: 13px"><tspan x="312.5" dy="0">인증 방식 지원: 알파 버전에만</tspan></text>
<text class="small" x="312.5" y="592" style="font-size: 13px" data-stage="ready"><tspan x="312.5" dy="0">→ 출시 전에 정식 버전도</tspan></text>
</g>
<path class="route" d="M640 80 V570 M640 330 H710"  />
<path class="flow" d="M640 80 V570 M640 330 H710" data-stage="launchflow"  />
<path class="arrow" d="M710 330 m-5 -4 5 4 -5 4"  />
<g class="" data-stage="launch"><rect class="accent-box" x="710" y="277" width="185" height="106" rx="7"  />
<text class="label" x="802" y="306" style="font-size: 15px"><tspan x="802" dy="0">9월 16일</tspan></text>
<text class="label" x="802" y="332" style="font-size: 15px"><tspan x="802" dy="0">공개 베타 출시</tspan></text>
<text class="small" x="802" y="359" style="font-size: 13px"><tspan x="802" dy="0">광고 MCP</tspan></text>
</g>
</svg>
<svg class="mobile-diagram" viewBox="0 0 320 760" role="img" aria-label={description}>
