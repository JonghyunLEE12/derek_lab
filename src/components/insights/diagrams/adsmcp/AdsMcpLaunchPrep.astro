<style>
svg .flow { opacity: 0; }
svg [data-stage] { opacity: .65; }
svg .flow[data-stage] { opacity: 0; }
svg .waiting { stroke-dasharray: 5 4; }
svg [data-stage="row0"] { animation: row0 15s ease-in-out infinite; }
@keyframes row0 { 0%, 0.0000%, 100% { opacity: .65; } 1.2000%, 99.1333% { opacity: 1; } }
svg [data-stage="check0"] { animation: check0 15s ease-in-out infinite; }
@keyframes check0 { 0%, 2.6667%, 100% { opacity: 0; } 3.8667%, 96.6667% { opacity: 1; } }
svg [data-stage="row1"] { animation: row1 15s ease-in-out infinite; }
@keyframes row1 { 0%, 6.6667%, 100% { opacity: .65; } 7.8667%, 99.1333% { opacity: 1; } }
svg [data-stage="check1"] { animation: check1 15s ease-in-out infinite; }
@keyframes check1 { 0%, 9.3333%, 100% { opacity: 0; } 10.5333%, 96.6667% { opacity: 1; } }
svg [data-stage="row2"] { animation: row2 15s ease-in-out infinite; }
@keyframes row2 { 0%, 13.3333%, 100% { opacity: .65; } 14.5333%, 99.1333% { opacity: 1; } }
svg [data-stage="check2"] { animation: check2 15s ease-in-out infinite; }
@keyframes check2 { 0%, 16.0000%, 100% { opacity: 0; } 17.2000%, 96.6667% { opacity: 1; } }
svg [data-stage="row3"] { animation: row3 15s ease-in-out infinite; }
@keyframes row3 { 0%, 20.0000%, 100% { opacity: .65; } 21.2000%, 99.1333% { opacity: 1; } }
svg [data-stage="check3"] { animation: check3 15s ease-in-out infinite; }
@keyframes check3 { 0%, 22.6667%, 100% { opacity: 0; } 23.8667%, 96.6667% { opacity: 1; } }
svg [data-stage="row4"] { animation: row4 15s ease-in-out infinite; }
@keyframes row4 { 0%, 26.6667%, 100% { opacity: .65; } 27.8667%, 99.1333% { opacity: 1; } }
svg [data-stage="check4"] { animation: check4 15s ease-in-out infinite; }
@keyframes check4 { 0%, 40.0000%, 100% { opacity: 0; } 41.2000%, 96.6667% { opacity: 1; } }
svg [data-stage="oauth"] { animation: oauth 15s ease-in-out infinite; }
@keyframes oauth { 0%, 26.6667%, 100% { opacity: .65; } 27.8667%, 42.5333% { opacity: 1; } 43.3333% { opacity: .65; } }
svg [data-stage="identity"] { animation: identity 15s ease-in-out infinite; }
@keyframes identity { 0%, 33.3333%, 100% { opacity: .65; } 34.5333%, 99.1333% { opacity: 1; } }
svg [data-stage="check5"] { animation: check5 15s ease-in-out infinite; }
@keyframes check5 { 0%, 70.0000%, 100% { opacity: 0; } 71.2000%, 96.6667% { opacity: 1; } }
svg [data-stage="ready"] { animation: ready 15s ease-in-out infinite; }
@keyframes ready { 0%, 66.6667%, 100% { opacity: 0; } 67.8667%, 99.1333% { opacity: 1; } }
svg [data-stage="launchflow"] { animation: launchflow 15s ease-in-out infinite; }
@keyframes launchflow { 0%, 73.3333%, 100% { opacity: 0; } 74.5333%, 85.8667% { opacity: 1; } 86.6667% { opacity: 0; } 0%, 73.3333% { stroke-dashoffset: 0; } 86.6667%, 100% { stroke-dashoffset: -56; } }
svg [data-stage="launch"] { animation: launch 15s ease-in-out infinite; }
@keyframes launch { 0%, 73.3333%, 100% { opacity: .65; } 74.5333%, 99.1333% { opacity: 1; } }
svg [data-stage="launch"] > rect { animation: launch-border 15s ease-in-out infinite; }
@keyframes launch-border { 0%, 73.3333%, 100% { stroke: var(--line); } 74.6667%, 99.9% { stroke: var(--accent); } }
svg [data-stage="pending"] { animation: pending 15s ease-in-out infinite; }
@keyframes pending { 0%, 43.333% { opacity: .45; } 49%, 61% { opacity: .85; } 55%, 66.667% { opacity: .45; } 73.333%, 99.9% { opacity: 0; } 100% { opacity: .45; } }
svg [data-stage="codex"] { opacity: 1; }
@media (prefers-reduced-motion: reduce) {
 svg *, svg [data-stage] { animation: none !important; transition: none !important; opacity: 1; }
 svg .flow { stroke-dasharray: none; stroke-width: 1.5; }
 svg .waiting { stroke-dasharray: 5 4; }
 svg .pending-layer { opacity: 0; }
}
</style>
