---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "출시 후에 돈 흐름이다. 도구 호출을 기록하고 대시보드로 본 다음 빵집 광고를 직접 분석해 봤다. 잘 쓰는지는 호출 횟수보다 분석이 판단과 운영에 도움이 되는지로 봐야 한다는 기준이 나왔고 미뤄 둔 광고 수정 기능의 필요성도 분명해졌다. 점선은 기능을 넓힌 뒤에도 계속 확인하겠다는 계획이다." } = Astro.props;
const description = "출시 후에 도구 호출 기록을 남기고 대시보드로 누가 계속 쓰는지 본 다음, 개밥먹기로 맡은 빵집 광고의 성과 분석을 에이전트에게 맡겨 소재 피로도와 예산 옮기기 제안을 받고, 잘 쓰는지는 호출 횟수만으로 판단할 수 없고 광고주의 판단과 실제 운영에 도움이 되는지가 더 중요하다는 기준을 얻어 다음 단계인 광고 수정 기능의 필요성이 분명해지며, 기능을 넓힌 뒤에도 계속 확인하겠다는 점선이 처음으로 돌아가는 고리를 그린 다이어그램입니다.";
---
<DiagramFrame caption={caption}>
<svg class="desktop-diagram" viewBox="0 0 920 510" role="img" aria-label={description}>
<path class="route" d="M260 96 H295"  />
<path class="flow" d="M260 96 H295" data-stage="r12"  />
<path class="arrow" d="M295 96 m-5 -4 5 4 -5 4"  />
<path class="route" d="M525 96 H560"  />
<path class="flow" d="M525 96 H560" data-stage="r23"  />
<path class="arrow" d="M560 96 m-5 -4 5 4 -5 4"  />
<path class="route" d="M675 147 V335"  />
<path class="flow" d="M675 147 V335" data-stage="r34"  />
<path class="arrow" d="M675 335 m-4 -5 4 5 4 -5"  />
<path class="route" d="M492 383 H400"  />
<path class="flow" d="M492 383 H400" data-stage="r45"  />
<path class="arrow" d="M400 383 m5 -4 -5 4 5 4"  />
<path class="route" d="M790 96 H890 V180"  />
<path class="flow" d="M790 96 H890 V180" data-stage="proposalflow"  />
<path class="route" d="M780 280 V308 H735 V335" style="stroke-width: 1" />
<path class="arrow" d="M735 335 m-4 -5 4 5 4 -5"  />
<path class="route" d="M250 431 V463 H12 V96 H30" stroke-dasharray="5 5" />
<path class="flow future" d="M250 431 V463 H12 V96 H30" data-stage="returnflow"  />
<path class="arrow" d="M30 96 m-5 -4 5 4 -5 4"  />
<text class="small" x="250" y="483" style="font-size: 13px" data-stage="returnlabel"><tspan x="250" dy="0">기능을 넓힌 뒤에도 계속 확인</tspan></text>
<text class="small" x="390" y="246" style="font-size: 13px"><tspan x="390" dy="0">출시 후</tspan></text>
<g class="" data-stage="node0"><rect class="box" x="30" y="45" width="230" height="102" rx="7"  />
<text class="label" x="145.0" y="70" style="font-size: 14px"><tspan x="145.0" dy="0">도구 호출 기록</tspan></text>
<text class="small" x="70" y="106" style="font-size: 12px" data-stage="record0"><tspan x="70" dy="0">어떤 광고주</tspan></text>
<text class="small" x="147" y="106" style="font-size: 12px" data-stage="record1"><tspan x="147" dy="0">· 어떤 AI 서비스</tspan></text>
<text class="small" x="224" y="106" style="font-size: 12px" data-stage="record2"><tspan x="224" dy="0">· 어떤 도구</tspan></text>
</g>
<g class="" data-stage="node1"><rect class="box" x="295" y="45" width="230" height="102" rx="7"  />
<text class="label" x="410.0" y="70" style="font-size: 14px"><tspan x="410.0" dy="0">대시보드</tspan></text>
<text class="small" x="410.0" y="94" style="font-size: 12px"><tspan x="410.0" dy="0">계속 쓰는지 · 누가 쓰는지 ·</tspan><tspan x="410.0" dy="18">어떤 업종인지</tspan></text>
</g>
<g class="" data-stage="node2"><rect class="box" x="560" y="45" width="230" height="102" rx="7"  />
<text class="label" x="675.0" y="70" style="font-size: 14px"><tspan x="675.0" dy="0">개밥먹기</tspan></text>
<text class="small" x="675.0" y="94" style="font-size: 12px"><tspan x="675.0" dy="0">빵집 광고 성과 분석을</tspan><tspan x="675.0" dy="18">에이전트에게</tspan></text>
</g>
<g class="" data-stage="node3"><rect class="box" x="492" y="335" width="310" height="126" rx="7"  />
<text class="label" x="647.0" y="360" style="font-size: 14px"><tspan x="647.0" dy="0">잘 쓰는지 보는 기준</tspan></text>
<text class="small" x="647.0" y="384" style="font-size: 12px" data-stage="oldmetric"><tspan x="647.0" dy="0">호출 횟수만으로는 판단할 수 없다</tspan></text>
<text class="small accent-text" x="647.0" y="415" style="font-size: 12px" data-stage="newmetric"><tspan x="647.0" dy="0">광고주의 판단과 실제 운영에 도움이 되는가</tspan></text>
</g>
<g class="" data-stage="node4"><rect class="box" x="100" y="335" width="300" height="96" rx="7"  />
<text class="label" x="250.0" y="360" style="font-size: 14px"><tspan x="250.0" dy="0">다음 단계: 광고 수정 기능</tspan></text>
<text class="small" x="250.0" y="387" style="font-size: 12px"><tspan x="250.0" dy="0">분석 결과를 실제 광고에 반영</tspan></text>
</g>
<g class="" data-stage="proposal"><rect class="box" x="695" y="180" width="210" height="100" rx="7" style="stroke-width: 1" />
<text class="label" x="800.0" y="204" style="font-size: 14px"><tspan x="800.0" dy="0">에이전트의 제안</tspan></text>
<text class="small" x="800.0" y="227" style="font-size: 12px" data-stage="proposal1"><tspan x="800.0" dy="0">소재 피로도가 높다 → 새 소재</tspan></text>
<text class="small" x="800.0" y="250" style="font-size: 12px" data-stage="proposal2"><tspan x="800.0" dy="0">성과 낮은 광고를 끈다</tspan><tspan x="800.0" dy="18">→ 예산을 다른 광고로</tspan></text>
</g>
</svg>
<svg class="mobile-diagram" viewBox="0 0 320 860" role="img" aria-label={description}>
