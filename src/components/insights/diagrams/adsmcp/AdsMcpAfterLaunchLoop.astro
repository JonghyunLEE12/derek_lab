<style>
svg .flow { opacity: 0; }
svg [data-stage] { opacity: .65; }
svg .flow[data-stage] { opacity: 0; }
svg [data-stage="node0"] { animation: node0 16s ease-in-out infinite; }
@keyframes node0 { 0%, 0.0000%, 100% { opacity: .65; } 1.1250%, 11.7500% { opacity: 1; } 12.5000% { opacity: .65; } }
svg [data-stage="node1"] { animation: node1 16s ease-in-out infinite; }
@keyframes node1 { 0%, 12.5000%, 100% { opacity: .65; } 13.6250%, 24.2500% { opacity: 1; } 25.0000% { opacity: .65; } }
svg [data-stage="node2"] { animation: node2 16s ease-in-out infinite; }
@keyframes node2 { 0%, 25.0000%, 100% { opacity: .65; } 26.1250%, 36.7500% { opacity: 1; } 37.5000% { opacity: .65; } }
svg [data-stage="node3"] { animation: node3 16s ease-in-out infinite; }
@keyframes node3 { 0%, 53.1250%, 100% { opacity: .65; } 54.2500%, 71.1250% { opacity: 1; } 71.8750% { opacity: .65; } }
svg [data-stage="node4"] { animation: node4 16s ease-in-out infinite; }
