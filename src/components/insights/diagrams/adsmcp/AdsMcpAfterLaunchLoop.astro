svg [data-stage="r12"] { animation: r12 16s ease-in-out infinite; }
@keyframes r12 { 0%, 12.5000%, 100% { opacity: 0; } 13.6250%, 24.2500% { opacity: 1; } 25.0000% { opacity: 0; } 0%, 12.5000% { stroke-dashoffset: 0; } 25.0000%, 100% { stroke-dashoffset: -56; } }
svg [data-stage="r23"] { animation: r23 16s ease-in-out infinite; }
@keyframes r23 { 0%, 25.0000%, 100% { opacity: 0; } 26.1250%, 36.7500% { opacity: 1; } 37.5000% { opacity: 0; } 0%, 25.0000% { stroke-dashoffset: 0; } 37.5000%, 100% { stroke-dashoffset: -56; } }
svg [data-stage="proposalflow"] { animation: proposalflow 16s ease-in-out infinite; }
@keyframes proposalflow { 0%, 37.5000%, 100% { opacity: 0; } 38.6250%, 52.3750% { opacity: 1; } 53.1250% { opacity: 0; } 0%, 37.5000% { stroke-dashoffset: 0; } 53.1250%, 100% { stroke-dashoffset: -56; } }
svg [data-stage="r34"] { animation: r34 16s ease-in-out infinite; }
@keyframes r34 { 0%, 53.1250%, 100% { opacity: 0; } 54.2500%, 71.1250% { opacity: 1; } 71.8750% { opacity: 0; } 0%, 53.1250% { stroke-dashoffset: 0; } 71.8750%, 100% { stroke-dashoffset: -56; } }
svg [data-stage="r45"] { animation: r45 16s ease-in-out infinite; }
