svg [data-stage="newmetric"] { animation: newmetric 16s ease-in-out infinite; }
@keyframes newmetric { 0%, 53.1250%, 100% { opacity: .65; } 54.2500%, 99.1875% { opacity: 1; } }
svg [data-stage="returnlabel"] { animation: returnlabel 16s ease-in-out infinite; }
@keyframes returnlabel { 0%, 81.2500%, 100% { opacity: .65; } 82.3750%, 93.0000% { opacity: 1; } 93.7500% { opacity: .65; } }
svg [data-stage="node4"] > rect { animation: node4-border 16s ease-in-out infinite; }
@keyframes node4-border { 0%, 71.8750%, 100% { stroke: var(--line); } 73.1250%, 99.9% { stroke: var(--accent); } }
svg [data-stage="oldmetric"] { animation: oldmetric 16s ease-in-out infinite; }
@keyframes oldmetric { 0%, 53.125%, 100% { opacity: .65; } 55%, 99.9% { opacity: .45; } }
@media (prefers-reduced-motion: reduce) {
 svg *, svg [data-stage] { animation: none !important; transition: none !important; opacity: 1; }
 svg .flow { stroke-dasharray: none; stroke-width: 1.5; }
 svg [data-stage="oldmetric"] { opacity: .45; }
 svg [data-stage="node4"] > rect { stroke: var(--accent); }
 svg .future.flow { stroke-dasharray: 5 4; }
}
