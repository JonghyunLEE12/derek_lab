---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "위는 API마다 도구를 따로 만든 경우다. AI가 광고 정보만 부르고 심사에서 막힌 사실을 놓친다. 아래는 광고주의 질문을 기준으로 만든 경우다. \"지난주 성과 분석해 줘\"를 세 단계로 나누고 단계마다 도구를 하나씩 뒀다. 원문에 도구 이름은 없어서 단계 이름만 적었다." } = Astro.props;
const description = "위쪽은 광고주가 \"이 광고 왜 안 나가?\"라고 물었을 때 API마다 따로 만든 광고 정보, 노출 상태, 심사 결과 도구 중에서 AI가 광고 정보만 부르고 \"켜져 있으니 괜찮아요\"라고 답하면서 심사에서 막힌 사실을 놓치는 장면이고, 아래쪽은 \"지난주 성과 분석해 줘\"라는 요청을 계정 정하기, 대상 찾기, 성과 보기 세 단계로 나누고 단계마다 도구를 하나씩 둬서 광고주센터 뒤의 여러 API를 도구 3개로 정리한 장면을 그린 다이어그램입니다.";
---
