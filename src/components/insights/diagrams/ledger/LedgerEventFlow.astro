---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = '원장 네 개는 그대로 두고 이벤트 발행만 추가했다. 이벤트는 Kafka를 거쳐 통합원장의 Consumer, Vitess 4샤드, API 순으로 흐르고 소비처는 API만 본다. 체결 한 건이 적재되기까지 30ms다.' } = Astro.props;
const description = '국내주식, 미국주식, 옵션, 채권 원장 네 개가 통합 스키마 이벤트를 Kafka 도메인별 토픽에 발행하고, 통합원장의 Consumer가 계좌별로 적재해 Vitess 4샤드에 저장하면 API가 내 계좌·홈, FDS·분석, OpenAPI 같은 소비처에 원장 대신 응답하는 흐름이며, 체결 발생부터 적재까지 30ms인 구조입니다.';
