svg .stage-4 { animation: stage-4 10s ease-in-out infinite; }
@keyframes stage-4 { 0%, 60%, 75%, 100% { opacity: 0; } 63%, 72% { opacity: 1; } }
svg .highlight-4 { animation: highlight-4 10s ease-in-out infinite; }
