---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = '먼저 듀얼 리드로 두 경로의 응답을 비교한다. diff가 없으면 임직원, 1%, 5%, 25%, 100% 순으로 통합원장 경로의 비율을 올린다. 이상하면 폴백 스위치 한 번으로 원장 경로로 돌아간다.' } = Astro.props;
const description = '고객 요청을 기존 원장 경로와 통합원장 경로로 같이 읽어 응답을 비교하는 듀얼 리드를 거친 뒤, 임직원, 1%, 5%, 25%, 100% 순으로 통합원장 경로의 비율을 올리고 이상이 있으면 폴백 스위치로 원장 경로로 되돌리는 전환 과정을 보여 주는 다이어그램입니다.';
---
<DiagramFrame caption={caption}>
  <svg class="desktop-diagram" viewBox="0 0 900 470" role="img" aria-label={description}>
    <path class="route" d="M164 130 H218 V70 H278" />
    <g class="old-flow">
    <path class="flow" d="M164 130 H218 V70 H278" />
    </g>
    <path class="arrow" d="M273 66 l5 4 -5 4" />
    <path class="route" d="M164 130 H218 V194 H278" />
    <g class="new-flow">
    <path class="flow" d="M164 130 H218 V194 H278" />
    </g>
    <path class="arrow" d="M273 190 l5 4 -5 4" />
    <path class="route" d="M500 70 H550 V130 H618" />
    <g class="compare-flow">
    <path class="flow" d="M500 70 H550 V130 H618" />
    </g>
    <path class="arrow" d="M613 126 l5 4 -5 4" />
    <path class="route" d="M500 194 H550 V130 H618" />
    <g class="compare-flow">
    <path class="flow" d="M500 194 H550 V130 H618" />
    </g>
    <path class="arrow" d="M613 126 l5 4 -5 4" />
    <path class="route" d="M280 52 H190 V108 H166" />
    <g class="response-flow">
    <path class="flow" d="M280 52 H190 V108 H166" />
    </g>
    <path class="arrow" d="M171 104 l-5 4 5 4" />
    <text class="small" x="214" y="40" style="font-size: 12px">응답</text>
    <path class="route" d="M814 334 H882 V12 H514 V52 H502" stroke-dasharray="4 5" />
    <g class="fallback-flow">
    <path class="flow" d="M814 334 H882 V12 H514 V52 H502" />
    </g>
    <path class="arrow" d="M507 48 l-5 4 5 4" />
    <g class="">
    <rect class="box" x="20" y="100" width="144" height="60" rx="7" />
    <text class="label" x="92.0" y="135.0" style="font-size: 14px">고객 요청</text>
    </g>
    <g class="pulse old-box">
    <rect class="box" x="280" y="40" width="220" height="60" rx="7" />
    <text class="label" x="390.0" y="63" style="font-size: 14px">기존 원장 경로</text>
    <text class="small" x="390.0" y="86" style="font-size: 12px">고객 응답은 이쪽 그대로</text>
    </g>
