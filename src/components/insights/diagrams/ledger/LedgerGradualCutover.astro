    </g>
    <text class="small" x="210" y="384" style="font-size: 12px">이상 시 즉시 폴백</text>
    <path class="route" d="M350 294 V318" />
    <g class="pulse stop-2">
    <rect class="box" x="310" y="320" width="80" height="36" rx="7" />
    <text class="label" x="350.0" y="343.0" style="font-size: 14px">5%</text>
    </g>
    <path class="route" d="M490 294 V318" />
    <g class="pulse stop-3">
