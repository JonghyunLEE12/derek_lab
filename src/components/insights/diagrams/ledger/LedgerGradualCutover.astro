    </g>
    <path class="arrow" d="M263 356 l-5 4 5 4" />
    <path class="route" d="M256 122 H280 V44 H242" />
    <g class="response-flow">
    <path class="flow" d="M256 122 H280 V44 H242" />
    </g>
    <path class="arrow" d="M247 40 l-5 4 5 4" />
    <text class="small" x="250" y="88" style="font-size: 12px">응답</text>
    <path class="route" d="M84 866 H12 V140 H62" stroke-dasharray="4 5" />
    <g class="fallback-flow">
    <path class="flow" d="M84 866 H12 V140 H62" />
    </g>
    <path class="arrow" d="M57 136 l5 4 -5 4" />
    <g class="">
    <rect class="box" x="80" y="20" width="160" height="48" rx="7" />
    <text class="label" x="160.0" y="49.0" style="font-size: 14px">고객 요청</text>
    </g>
    <g class="pulse old-box">
    <rect class="box" x="64" y="110" width="192" height="60" rx="7" />
    <text class="label" x="160.0" y="133" style="font-size: 14px">기존 원장 경로</text>
    <text class="small" x="160.0" y="156" style="font-size: 12px">고객 응답은 이쪽 그대로</text>
    </g>
    <g class="pulse new-box">
    <rect class="accent-box" x="64" y="220" width="192" height="60" rx="7" />
    <text class="label" x="160.0" y="243" style="font-size: 14px">통합원장 경로</text>
    <text class="small" x="160.0" y="266" style="font-size: 12px">같이 읽기만</text>
    </g>
    <g class="pulse compare-box">
    <rect class="box" x="64" y="330" width="192" height="60" rx="7" />
    <text class="label" x="160.0" y="353" style="font-size: 14px">응답 비교</text>
    <text class="small" x="160.0" y="376" style="font-size: 12px">diff → 알람</text>
    </g>
    <path class="route" d="M28 440 V778" />
    <path class="route" d="M28 457 H46" />
    <g class="pulse stop-0">
    <rect class="box" x="46" y="440" width="76" height="34" rx="7" />
