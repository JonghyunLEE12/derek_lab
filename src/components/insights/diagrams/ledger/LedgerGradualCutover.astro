<style>
svg .label { fill: var(--muted); }
svg .pulse .box { stroke: var(--line); }
svg .flow { animation-duration: 16s; }
svg .old-flow { animation: old-flow 16s ease-in-out infinite; }
svg .new-flow { animation: new-flow 16s ease-in-out infinite; }
@keyframes old-flow { 0%, 87.5%, 100% { opacity: 0; } 6%, 25% { opacity: 1; } 65%, 75% { opacity: .4; } 81% { opacity: 1; } }
@keyframes new-flow { 0%, 87.5%, 100% { opacity: 0; } 6%, 25% { opacity: .4; } 65%, 75% { opacity: 1; } 81% { opacity: .4; } }
svg .response-flow { animation: response-flow 16s ease-in-out infinite; }
@keyframes response-flow { 0%, 25%, 100% { opacity: 0; } 8%, 17% { opacity: 1; } }
svg .compare-flow { animation: compare-flow 16s ease-in-out infinite; }
@keyframes compare-flow { 0%, 8%, 25%, 100% { opacity: 0; } 13%, 20% { opacity: 1; } }
svg .old-box { animation: old-box 16s ease-in-out infinite; }
@keyframes old-box { 0%, 25%, 75%, 87.5%, 100% { opacity: .65; } 10%, 81% { opacity: 1; } }
svg .new-box { animation: new-box 16s ease-in-out infinite; }
@keyframes new-box { 0%, 25%, 87.5%, 100% { opacity: .65; } 12%, 65%, 75% { opacity: 1; } }
svg .compare-box { animation: compare-box 16s ease-in-out infinite; }
@keyframes compare-box { 0%, 13%, 25%, 100% { opacity: .65; } 20% { opacity: 1; } }
svg .fallback-flow { animation: fallback-flow 16s ease-in-out infinite; }
@keyframes fallback-flow { 0%, 75%, 87.5%, 100% { opacity: 0; } 81% { opacity: 1; } }
svg .fallback-box { animation: fallback-box 16s ease-in-out infinite; }
@keyframes fallback-box { 0%, 75%, 87.5%, 100% { opacity: .65; } 81% { opacity: 1; } }
svg .conclusion { animation: conclusion 16s ease-in-out infinite; }
@keyframes conclusion { 0%, 87.5%, 100% { opacity: .65; } 94% { opacity: 1; } }
.progress-marker { fill: var(--accent); animation: progress 16s ease-in-out infinite; }
/* The base position is 100%, so reduced motion needs no animated state. */
@keyframes progress {
  0%, 25% { transform: translate(var(--start-x), var(--start-y)); opacity: 1; }
  35% { transform: translate(calc(var(--start-x) + var(--step-x)), calc(var(--start-y) + var(--step-y))); opacity: 1; }
  45% { transform: translate(calc(var(--start-x) + var(--step-x) * 2), calc(var(--start-y) + var(--step-y) * 2)); opacity: 1; }
  55% { transform: translate(calc(var(--start-x) + var(--step-x) * 3), calc(var(--start-y) + var(--step-y) * 3)); opacity: 1; }
  65%, 87.5% { transform: translate(0, 0); opacity: 1; }
  92% { transform: translate(0, 0); opacity: 0; }
  94% { transform: translate(var(--start-x), var(--start-y)); opacity: 0; }
  100% { transform: translate(var(--start-x), var(--start-y)); opacity: 1; }
}
svg .stop-0 { animation: stop-0 16s ease-in-out infinite; }
@keyframes stop-0 { 0%, 25%, 35%, 100% { opacity: .65; } 28% { opacity: 1; } }
svg .stop-1 { animation: stop-1 16s ease-in-out infinite; }
@keyframes stop-1 { 0%, 35%, 45%, 100% { opacity: .65; } 38% { opacity: 1; } }
svg .stop-2 { animation: stop-2 16s ease-in-out infinite; }
@keyframes stop-2 { 0%, 45%, 55%, 100% { opacity: .65; } 48% { opacity: 1; } }
svg .stop-3 { animation: stop-3 16s ease-in-out infinite; }
@keyframes stop-3 { 0%, 55%, 65%, 100% { opacity: .65; } 58% { opacity: 1; } }
svg .stop-4 { animation: stop-4 16s ease-in-out infinite; }
@keyframes stop-4 { 0%, 65%, 75%, 100% { opacity: .65; } 68% { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { svg * { animation: none !important; opacity: 1; transform: none !important; } svg .old-flow, svg .new-flow { opacity: .65; } }
</style>
