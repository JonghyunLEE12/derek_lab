    <rect class="box" x="590" y="320" width="80" height="36" rx="7" />
    <text class="label" x="630.0" y="343.0" style="font-size: 14px">100%</text>
    </g>
    <text class="small" x="630" y="384" style="font-size: 12px">유가잔고 → 주문 →</text>
    <text class="small" x="630" y="404" style="font-size: 12px">거래내역</text>
    <circle class="progress-marker" cx="630" cy="294" r="5" style="--start-x: -560px; --start-y: 0px; --step-x: 140px; --step-y: 0px;" />
    <g class="pulse fallback-box">
    <rect class="box" x="734" y="336" width="160" height="62" rx="7" />
    <text class="label" x="814.0" y="359" style="font-size: 14px">폴백 스위치</text>
    <text class="small" x="814.0" y="382" style="font-size: 12px">설정 한 번으로 원장으로</text>
    </g>
    <g class="pulse conclusion">
    <text class="small" x="450" y="452" style="font-size: 13px">수십억 건 이관 · 서비스는 한 번도 안 멈춤</text>
    </g>
    </svg>
  <svg class="mobile-diagram" viewBox="0 0 320 960" role="img" aria-label={description}>
    <path class="route" d="M80 44 H32 V140 H62" />
    <g class="old-flow">
    <path class="flow" d="M80 44 H32 V140 H62" />
    </g>
    <path class="arrow" d="M57 136 l5 4 -5 4" />
    <path class="route" d="M80 44 H32 V250 H62" />
