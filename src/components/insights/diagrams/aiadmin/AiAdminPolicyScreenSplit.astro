---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "어드민에 필요한 일을 둘로 나눈 그림. 화면은 AI가 API 스키마를 보고 React 코드로 만든다. 그 화면의 호출은 플랫폼 프록시를 지나가고 거기서 정책이 적용되고 호출 기록이 남는다." } = Astro.props;
const description = "어드민에 필요한 일을 둘로 나눠 데이터를 다루는 정책은 플랫폼이 맡고 데이터를 보여주는 화면은 AI가 만드는 구조이며, AI가 만든 화면의 호출이 플랫폼 프록시를 지나 등록된 API로 가는 동안 마스킹, 조회 사유, 암호화 정책이 자동 적용되고 호출 기록이 남는 것을 보여 주는 다이어그램입니다.";
---
<DiagramFrame caption={caption}>
<svg class="desktop-diagram" viewBox="0 0 920 555" role="img" aria-label={description}>
<g class="pulse root">
<rect class="box" x="350" y="15" width="220" height="52" rx="8" />
<text class="label" x="460.0" y="42" style="font-size: 14px"><tspan x="460.0" dy="0">어드민에 필요한 일</tspan></text>
</g>
<path class="route" d="M460 67 V85 H230.0 V110" />
<path class="flow branches" d="M460 67 V85 H230.0 V110" />
<path class="arrow" d="M230.0 110 m-4 -5 4 5 4 -5" />
<rect class="box" x="25" y="110" width="410" height="180" rx="8" />
<text class="small" x="230.0" y="136" style="font-size: 14px"><tspan x="230.0" dy="0">데이터를 다루는 정책은</tspan></text>
<g class="">
<text class="label" x="230.0" y="163" style="font-size: 17px"><tspan x="230.0" dy="0">플랫폼이 맡아요</tspan></text>
</g>
<g class="policy0">
<text class="small" x="230.0" y="194" style="font-size: 13px"><tspan x="230.0" dy="0">등록된 API를 프록시하며 정책을 자동 적용해요</tspan></text>
</g>
<g class="policy1">
<text class="small" x="230.0" y="229" style="font-size: 13px"><tspan x="230.0" dy="0">마스킹 · 조회 사유 · 암호화</tspan></text>
</g>
<g class="policy2">
<text class="small" x="230.0" y="264" style="font-size: 13px"><tspan x="230.0" dy="0">호출 기록이 자동으로 남아요</tspan></text>
</g>
<path class="route" d="M460 67 V85 H690.0 V110" />
<path class="flow branches" d="M460 67 V85 H690.0 V110" />
<path class="arrow" d="M690.0 110 m-4 -5 4 5 4 -5" />
<rect class="box" x="485" y="110" width="410" height="180" rx="8" />
<text class="small" x="690.0" y="136" style="font-size: 14px"><tspan x="690.0" dy="0">데이터를 보여주는 화면은</tspan></text>
<g class="pulse ai">
<text class="label accent-text" x="690.0" y="163" style="font-size: 17px"><tspan x="690.0" dy="0">AI가 만들어요</tspan></text>
</g>
<g class="ai0">
<text class="small" x="690.0" y="194" style="font-size: 13px"><tspan x="690.0" dy="0">API 스키마를 참고해서 React 코드를 생성해요</tspan></text>
</g>
<g class="ai1">
<text class="small" x="690.0" y="229" style="font-size: 13px"><tspan x="690.0" dy="0">테이블 · 필터 · 상세 페이지</tspan></text>
</g>
<g class="ai2">
<text class="small" x="690.0" y="264" style="font-size: 13px"><tspan x="690.0" dy="0">자연어로 요청하면 돼요</tspan></text>
</g>
<path class="route" d="M690 290 V335" />
<path class="arrow" d="M690 335 m-4 -5 4 5 4 -5" />
<path class="route" d="M230 290 V335" />
<path class="arrow" d="M230 335 m-4 -5 4 5 4 -5" />
