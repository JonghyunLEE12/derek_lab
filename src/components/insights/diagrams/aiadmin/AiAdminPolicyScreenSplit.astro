<style>
svg .mono { font-family: ui-monospace, monospace; }
svg .pulse .box { stroke: var(--line); }
svg .dot { fill: var(--muted); }
svg .signal { fill: var(--accent); }
svg .flow { opacity: 0; }
svg .root { animation: root 14s ease-in-out infinite; }
@keyframes root {0%, 100% { opacity: .65; }0.0000%, 10.7143% { opacity: .65; }1.4286%, 9.2857% { opacity: 1; }}
svg .ai { animation: ai 14s ease-in-out infinite; }
@keyframes ai {0%, 100% { opacity: .65; }10.7143%, 32.1429% { opacity: .65; }12.1429%, 30.7143% { opacity: 1; }}
svg .screen { animation: screen 14s ease-in-out infinite; }
@keyframes screen {0%, 100% { opacity: .65; }28.5714%, 32.1429% { opacity: .65; }29.4643%, 31.2500% { opacity: 1; }}
svg .api { animation: api 14s ease-in-out infinite; }
@keyframes api {0%, 100% { opacity: .65; }75.0000%, 82.1429% { opacity: .65; }76.4286%, 80.7143% { opacity: 1; }}
svg .ai0 { animation: ai0 14s ease-in-out infinite; }
@keyframes ai0 {0%, 100% { opacity: .65; }10.7143%, 17.8571% { opacity: .65; }12.1429%, 16.4286% { opacity: 1; }}
svg .ai1 { animation: ai1 14s ease-in-out infinite; }
@keyframes ai1 {0%, 100% { opacity: .65; }17.8571%, 25.0000% { opacity: .65; }19.2857%, 23.5714% { opacity: 1; }}
svg .ai2 { animation: ai2 14s ease-in-out infinite; }
@keyframes ai2 {0%, 100% { opacity: .65; }25.0000%, 32.1429% { opacity: .65; }26.4286%, 30.7143% { opacity: 1; }}
svg .policy0 { animation: policy0 14s ease-in-out infinite; }
@keyframes policy0 {0%, 100% { opacity: .65; }42.8571%, 50.0000% { opacity: .65; }44.2857%, 48.5714% { opacity: 1; }}
svg .policy1 { animation: policy1 14s ease-in-out infinite; }
@keyframes policy1 {0%, 100% { opacity: .65; }50.0000%, 57.1429% { opacity: .65; }51.4286%, 55.7143% { opacity: 1; }}
svg .policy2 { animation: policy2 14s ease-in-out infinite; }
@keyframes policy2 {0%, 100% { opacity: .65; }57.1429%, 64.2857% { opacity: .65; }58.5714%, 62.8571% { opacity: 1; }}
svg .branches { animation: branches 14s ease-in-out infinite; }
@keyframes branches {0%, 100% { opacity: 0; }0.0000%, 10.7143% { opacity: 0; }1.4286%, 9.2857% { opacity: 1; }0% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -224; }}
svg .record { animation: record 14s ease-in-out infinite; }
@keyframes record {0%, 100% { opacity: 0; }57.1429%, 98.5714% { opacity: 0; }58.5714%, 97.1429% { opacity: 1; }}
svg .call { animation: call 14s ease-in-out infinite; }
@keyframes call { 0%, 31% { opacity: 0; transform: translate(var(--sx),var(--sy)); } 32.14% { opacity: 1; transform: translate(var(--sx),var(--sy)); } 42.86%, 67.86% { opacity: 1; transform: translate(var(--px),var(--py)); } 73% { opacity: 1; transform: translate(var(--mx),var(--my)); } 82.14% { opacity: 0; transform: translate(var(--ex),var(--ey)); } 100% { opacity: 0; transform: translate(var(--ex),var(--ey)); } }
@media (prefers-reduced-motion: reduce) {
 svg *, svg .pulse, svg .flow { animation: none !important; transition: none !important; opacity: 1; }
 svg .flow { stroke-dasharray: none; stroke-width: 1.5; }
svg .call { transform: translate(var(--rx),var(--ry)); }
}
</style>
