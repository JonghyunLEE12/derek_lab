<rect class="box" x="350" y="421" width="120" height="38" rx="8" />
<text class="small" x="410" y="445" style="font-size: 14px"><tspan x="410" dy="0">호출 기록</tspan></text>
<g class="record">
<path class="arrow" d="M365 453 H455" /></g>
<circle class="signal call" cx="0" cy="0" r="4" style="--sx:585px;--sy:370px;--px:330px;--py:370px;--mx:230px;--my:370px;--ex:230px;--ey:460px;--rx:230px;--ry:320px" /></svg>
<svg class="mobile-diagram" viewBox="0 0 320 885" role="img" aria-label={description}>
