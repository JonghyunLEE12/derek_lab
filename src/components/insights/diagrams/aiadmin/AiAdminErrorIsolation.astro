<DiagramFrame caption={caption}>
<svg class="desktop-diagram" viewBox="0 0 920 900" role="img" aria-label={description}>
<g class="panel-a">
<text class="label" x="460" y="25" style="font-size: 17px"><tspan x="460" dy="0">시도 1: Dev Server</tspan></text>
<g class="pulse server">
<rect class="accent-box" x="260" y="48" width="400" height="78" rx="8" />
<text class="label" x="460.0" y="75" style="font-size: 14px"><tspan x="460.0" dy="0">Next.js Dev Server 1개</tspan></text>
<text class="small" x="460.0" y="100" style="font-size: 14px"><tspan x="460.0" dy="0">모든 프로젝트 파일을 함께 감시해요</tspan></text>
</g>
<text class="small" x="460" y="151" style="font-size: 13px"><tspan x="460" dy="0">iframe으로 연결해요</tspan></text>
<path class="route" d="M155.0 200 V174 H460 V126" />
<path class="flow wire0" d="M155.0 200 V174 H460 V126" />
