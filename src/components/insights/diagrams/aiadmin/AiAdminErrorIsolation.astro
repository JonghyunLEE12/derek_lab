---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "위가 시도 1, 아래가 시도 2다. 개발 서버 하나를 같이 쓰면 사용자 A의 컴파일 에러가 B와 C 화면에도 뜬다. Sandpack으로 실행 위치를 각자의 브라우저로 옮기자 에러는 A에게만 보였고 대신 첫 화면까지 47초가 걸렸다." } = Astro.props;
const description = "시도 1에서는 Next.js Dev Server 한 개에 사용자 A, B, C의 iframe이 연결돼 있어 사용자 A의 컴파일 에러가 서버를 거쳐 B와 C 화면에도 Failed to compile로 보이고, 시도 2에서는 Sandpack으로 각 사용자의 브라우저 안에서 코드를 실행해 에러가 A에게만 보이지만 렌더링 시점에 패키지를 전부 내려받아 Preview 첫 화면이 보이기까지 47초가 걸린 것을 비교한 다이어그램입니다.";
