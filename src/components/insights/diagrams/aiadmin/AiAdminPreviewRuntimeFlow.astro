---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "직접 만든 Preview Runtime의 흐름. 코드는 브라우저에서 esbuild-wasm이 ESM 번들로 묶고 패키지는 미리 만든 걸 import map으로 연결한다. 실행에 성공하면 iframe을 통째로 교체하고 실패하면 마지막 정상 화면을 그대로 둔다." } = Astro.props;
const description = "사용자 브라우저에서 가상 파일 시스템의 userLayer, projectLayer, templateLayer, runtimeLayer를 플러그인으로 연결한 esbuild-wasm이 코드를 ESM 번들로 묶고, 미리 만든 패키지를 import map으로 연결해 번들을 실행한 뒤, 실행에 성공하면 iframe을 통째로 교체하는 커밋을 하고 실패하면 교체하지 않고 마지막 정상 화면에 에러 오버레이만 띄우는 롤백을 하는 Preview Runtime의 흐름을 보여 주는 다이어그램입니다.";
