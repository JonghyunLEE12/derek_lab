---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "맨 위가 조합에 이름을 붙이는 과정이다. entry 목록과 lockfile 해시를 함께 해싱한 값이 packageSetHash다. 가운데 줄은 서버가 조합이 바뀔 때 한 번만 하는 일이고 아래 줄은 브라우저가 프리뷰를 열 때마다 하는 일이다." } = Astro.props;
const description = "브라우저에 공개하는 entry 목록과 Yarn이 확정한 lockfile 해시를 sha256으로 함께 해싱해 packageSetHash를 만들고, 서버가 패키지 조합이 바뀔 때 한 번만 빈 워크스페이스에 package.json을 복사해 yarn install과 Vite 빌드를 거쳐 importmap과 함께 S3 해시 경로에 올리면, 브라우저는 Preview를 열 때마다 package.json의 packageSetHash로 해시 경로의 importmap.json을 받아 external로 남긴 패키지를 실제 파일에 연결하고 같은 조합은 캐시를 재사용하는 흐름을 보여 주는 다이어그램입니다.";
---
<DiagramFrame caption={caption}>
<svg class="desktop-diagram" viewBox="0 0 920 720" role="img" aria-label={description}>
<g class="pulse entry">
<rect class="box" x="20" y="20" width="310" height="76" rx="8" />
<text class="label" x="175.0" y="47" style="font-size: 14px"><tspan x="175.0" dy="0">브라우저에 공개하는 entry 목록</tspan></text>
<text class="small" x="175.0" y="72" style="font-size: 14px"><tspan x="175.0" dy="0">순서가 달라도 같도록 정렬해요</tspan></text>
</g>
<g class="pulse lock">
<rect class="box" x="20" y="125" width="310" height="76" rx="8" />
<text class="label" x="175.0" y="152" style="font-size: 14px"><tspan x="175.0" dy="0">Yarn이 확정한 lockfile 해시</tspan></text>
<text class="small" x="175.0" y="177" style="font-size: 14px"><tspan x="175.0" dy="0">전이 의존성 버전까지 반영돼요</tspan></text>
</g>
<path class="route" d="M330 58 H365 V110 H390" />
<path class="flow hash-in" d="M330 58 H365 V110 H390" />
<path class="arrow" d="M390 110 m-5 -4 5 4 -5 4" />
