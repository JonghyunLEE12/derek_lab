---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "위가 글쓴이가 말한 스래싱이다. 한 건이 1시간이면 끝나니 바로 잡고 그러느라 스프린트 목표는 거의 안 움직인다. 아래는 원문이 적은 해법이다. 동시성을 제한하고 치명적인 것만 끼어들게 둔다." } = Astro.props;
const description = "위는 들어오는 버그마다 포커스가 스프린트 목표에서 버그 A, B, C로 옮겨 다니느라 스프린트 목표 진행이 거의 멈추는 스래싱 상태이고, 아래는 동시성 제한 게이트가 버그 B와 C를 대기시키고 치명적 버그만 통과시켜 포커스가 스프린트 목표에 머물며 진행이 끝까지 차는 해법을 보여 주는, 한 건당 1시간 이내라 바로 잡게 되는 일이 어떻게 전환 비용이 되는지를 그린 다이어그램입니다.";
