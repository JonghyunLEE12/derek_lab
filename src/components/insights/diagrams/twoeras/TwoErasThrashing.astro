svg [data-stage="self"]:not(.flow) { animation: self 16s ease-in-out infinite; }
@keyframes self { 0%, 100% { opacity: .65; } 12.5%, 18.75% { opacity: .65; } 13.750000000000002%, 17.5% { opacity: 1; } 31.25%, 37.5% { opacity: .65; } 32.5%, 36.25% { opacity: 1; } 50.0%, 56.25% { opacity: .65; } 51.24999999999999%, 55.00000000000001% { opacity: 1; } }
