---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "위가 AI 이전 PostHog의 하루, 아래가 AI 네이티브 Tano의 흐름이다. 위에서는 리뷰 대기에서 제일 오래 멈추고 아래에서는 에이전트 여러 개가 각자 끝나는 대로 PR이 올라온다. 숫자는 원문 본문에 적힌 것만 넣었다." } = Astro.props;
const description = "AI 이전 PostHog에서는 코드 작성, PR 열기, 리뷰 대기, 머지가 한 줄로 이어지고 리뷰 대기에서 가장 오래 멈추며 월 8~20개 PR을 머지했고, AI 네이티브 Tano에서는 계획을 훑은 뒤 에이전트 3~5개가 병렬로 1~2시간씩 돌아 각자 PR과 자동 리뷰와 HTML 요약을 만들고 사람이 확인해 1시간 미만에 머지하며 월 200개 이상, PostHog 대비 11배의 PR을 내는 두 작업 흐름을 위아래로 비교한 다이어그램입니다.";
