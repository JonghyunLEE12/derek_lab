---
import DiagramFrame from '../DiagramFrame.astro';
interface Props { caption?: string; }
const { caption = "슬라이드 'quick fixes considered harmful'의 날짜 세 개를 옮겼다. 9월 9일 한 줄이던 setTimeout이 10월 3일 공유 모듈로 복사되고 10월 17일에는 타이머 183개가 된다. 점 개수는 183개를 그대로 세지 않고 많아졌다는 것만 나타냈다." } = Astro.props;
const description = "9월 9일 화면 깜빡임을 고치려고 넣은 setTimeout 한 줄과 그것을 정당화하는 주석, 10월 3일 그 코드가 공유 모듈로 복사된 모습, 10월 17일 타이머가 183개로 늘어 클라이언트와 에이전트 성능이 나빠진 모습을 왼쪽에서 오른쪽으로 보여 주는 다이어그램입니다. 마지막에 땜질 하나가 복사를 거쳐 패턴이 된다는 문장이 강조됩니다.";
---
<DiagramFrame caption={caption}>
<svg class="desktop-diagram" viewBox="0 0 920 340" role="img" aria-label={description}>
<text class="label" x="150" y="56" style="font-size: 16px"><tspan x="150" dy="0">9월 9일</tspan></text>
<g class="c1">
<rect class="accent-box" x="15.0" y="70" width="270" height="120" rx="8" />
<text class="small mono" x="150" y="104" style="font-size: 10px"><tspan x="150" dy="0">// release later, in case it comes back</tspan></text>
<text class="mono" x="150" y="128" style="font-size: 12px"><tspan x="150" dy="0">setTimeout(() =&gt; release(id), 0)</tspan></text>
<text class="small" x="150" y="162" style="font-size: 13px"><tspan x="150" dy="0">화면 깜빡임을 고치려고 넣은 한 줄</tspan></text>
</g>
<g class="c1note">
