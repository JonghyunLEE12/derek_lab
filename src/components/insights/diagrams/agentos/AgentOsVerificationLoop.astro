<text class="small start" x="24" y="775" style="font-size: 12px">Bombadil이 UI 버그를 몇 개 잡았어요</text>
</g>
<text class="small" x="160" y="812" style="font-size: 13px"><tspan x="160" dy="0">에이전트 덕에 쓰기 비쌌던</tspan><tspan x="160" dy="19">도구의 비용이 내려갔어요</tspan></text>
</svg>
</DiagramFrame>
<style>
svg .mono { font-family: ui-monospace, monospace; }
svg .cmd { text-anchor: start; fill: var(--accent); }
svg .start { text-anchor: start; }
svg .solid { fill: var(--surface); }
svg .backing { fill: var(--surface); stroke: none; }
svg .loop { animation-duration: 6s; }
svg .term { animation: term 18s ease-in-out infinite; }
@keyframes term { 0%, 13%, 100% { opacity: .65; } 15%, 98% { opacity: 1; } }
svg .n0 { animation: n0 18s ease-in-out infinite; }
@keyframes n0 {0%, 2.00%, 14.00%, 100% { opacity: 0.55; } 3.25%, 12.75% { opacity: 1; }}
svg .n1 { animation: n1 18s ease-in-out infinite; }
@keyframes n1 {0%, 14.00%, 26.00%, 100% { opacity: 0.55; } 15.25%, 24.75% { opacity: 1; }}
svg .n2 { animation: n2 18s ease-in-out infinite; }
@keyframes n2 {0%, 26.00%, 38.00%, 100% { opacity: 0.55; } 27.25%, 36.75% { opacity: 1; }}
svg .n3 { animation: n3 18s ease-in-out infinite; }
@keyframes n3 {0%, 38.00%, 50.00%, 100% { opacity: 0.55; } 39.25%, 48.75% { opacity: 1; }}
svg .c0 { animation: c0 18s ease-in-out infinite; }
@keyframes c0 {0%, 15.00%, 98.75%, 100% { opacity: 0; } 16.25%, 97.50% { opacity: 1; }}
svg .c1 { animation: c1 18s ease-in-out infinite; }
@keyframes c1 {0%, 18.00%, 98.75%, 100% { opacity: 0; } 19.25%, 97.50% { opacity: 1; }}
svg .c2 { animation: c2 18s ease-in-out infinite; }
@keyframes c2 {0%, 21.00%, 98.75%, 100% { opacity: 0; } 22.25%, 97.50% { opacity: 1; }}
svg .l0 { animation: l0 18s ease-in-out infinite; }
@keyframes l0 {0%, 52.00%, 63.00%, 100% { opacity: 0.55; } 53.25%, 61.75% { opacity: 1; }}
svg .l1 { animation: l1 18s ease-in-out infinite; }
@keyframes l1 {0%, 63.00%, 74.00%, 100% { opacity: 0.55; } 64.25%, 72.75% { opacity: 1; }}
svg .l2 { animation: l2 18s ease-in-out infinite; }
@keyframes l2 {0%, 74.00%, 85.00%, 100% { opacity: 0.55; } 75.25%, 83.75% { opacity: 1; }}
svg .l3 { animation: l3 18s ease-in-out infinite; }
@keyframes l3 {0%, 85.00%, 96.00%, 100% { opacity: 0.55; } 86.25%, 94.75% { opacity: 1; }}
@media (prefers-reduced-motion: reduce) {
 svg *, svg .pulse, svg .flow { animation: none !important; transition: none !important; opacity: 1; }
 svg .flow { stroke-dasharray: none; stroke-width: 1.5; }
}
</style>
